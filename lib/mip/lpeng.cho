edition 7;

module solve.lpeng;

// The LP engine behind the branch-and-bound search (docs/design.md section 19.1): a thin interface over the dense dual simplex, so that the sparse solver of section 18
// can replace it without touching the search. The state is two slices, `w` (floats) and `wi` (ints), whose layout is the simplex's; only this file and simplex.cho know it.
//
//   wlen/wilen    the length of the two slices for a model with m rows and n columns
//   load          put the model in the state (slack basis, bounds of the root)
//   run           the dual simplex from the current state to optimality, infeasibility or a limit
//   set_bounds    change the bounds of one structural column in the state, keeping it dual feasible
//   refresh       recompute the basic values from the nonbasic ones (after set_bounds)
//   value         the value of a structural column
//   copy          copy a whole state (root tableau <-> working tableau)

import solve.layout as l;
import solve.simplex as sx;

pub fn wlen(m: int, n: int) -> [] int {
    return m * (n + m) + 6 * (n + m) + m + 1;
}

pub fn wilen(m: int, n: int) -> [] int {
    return m + 3 * (n + m) + 1;
}

pub fn too_large(m: int, n: int) -> [] bool {
    return m * (n + m) + 6 * (n + m) + m > sx.max_cells();
}

pub fn load[&a, &b, &c, &d](ints: &a [int], fl: &b [float], w: &!c [float], wi: &!d [int], m: int, n: int) -> [] int {
    return sx.init_state(ints, fl, w, wi, m, n);
}

// Iterations of this call go to stats[0]. Result codes: simplex.s_optimal, s_infeasible, s_limit.
pub fn run[&c, &d, &e](w: &!c [float], wi: &!d [int], stats: &!e [int], m: int, n: int, limit: int) -> [] int {
    return sx.dual_loop(w, wi, stats, m, n, limit);
}

// The bounds of structural column j become [lo, hi]. A nonbasic column keeps the side it sits on (so its reduced cost keeps its sign and the state stays dual feasible)
// and moves to the new bound on that side; a basic column keeps its value, which `refresh` and the dual simplex then repair.
pub fn set_bounds[&c, &d](w: &!c [float], wi: &!d [int], m: int, n: int, j: int, lo: float, hi: float) -> [] int {
    let big = n + m;
    let o_v = m * big + big;
    let o_l = o_v + big;
    let o_h = o_l + big;
    w[o_l + j] = lo;
    w[o_h + j] = hi;
    if wi[m + j] < 0 {
        if wi[m + big + j] == 0 {
            w[o_v + j] = lo;
        } else {
            w[o_v + j] = hi;
        }
    }
    return 0;
}

// z_B(i) = -sum over the nonbasic columns of T[i][j] z_j.
pub fn refresh[&c, &d](w: &!c [float], wi: &!d [int], m: int, n: int) -> [] int {
    let big = n + m;
    let o_v = m * big + big;
    var i = 0;
    while i < m {
        var s = 0.0;
        var j = 0;
        while j < big {
            if wi[m + j] < 0 {
                s = s + w[i * big + j] * w[o_v + j];
            }
            j = j + 1;
        }
        w[o_v + wi[i]] = -s;
        i = i + 1;
    }
    return 0;
}

pub fn value[&c](w: &c [float], m: int, n: int, j: int) -> [] float {
    return w[m * (n + m) + (n + m) + j];
}

pub fn copy_f[&c, &d](dst: &!c [float], src: &d [float]) -> [] int {
    var k = 0;
    while k < len(src) {
        dst[k] = src[k];
        k = k + 1;
    }
    return 0;
}

pub fn copy_i[&c, &d](dst: &!c [int], src: &d [int]) -> [] int {
    var k = 0;
    while k < len(src) {
        dst[k] = src[k];
        k = k + 1;
    }
    return 0;
}
