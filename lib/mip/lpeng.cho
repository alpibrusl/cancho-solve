edition 7;

module solve.lpeng;

// The LP engine behind the branch-and-bound search (docs/design.md sections 19.1 and 19.6): a thin interface over the dense dual simplex (simplex.cho) and over the sparse
// revised dual simplex (revised.cho), chosen by `eng` (0 dense, 1 sparse), so that the search does not know which it runs. The state is four slices: `w` (floats) and `wi` (ints),
// whose layout is the engine's, and `fi`/`ff`, the factorisation of the sparse engine (length 1 and unused for the dense one). Only this file and the two solvers know the layout.
//
//   wlen/wilen/filen/fflen  the lengths of the slices for a model with m rows, n columns and nnz nonzeros
//   too_large     the model does not fit the engine
//   load          put the model in the state (slack basis, bounds of the root; the sparse engine factorises it)
//   run           the dual simplex from the current state to optimality, infeasibility or a limit (codes: simplex.s_optimal, s_infeasible, s_limit; more than 2 is numerical trouble)
//   set_bounds    change the bounds of one structural column in the state, keeping it dual feasible
//   refresh       recompute the basic values from the nonbasic ones (after set_bounds); the sparse engine also repairs the duals and, after `copied`, refactorises
//   copied        the state was overwritten by a copy (the sparse engine must refactorise at the next `refresh`)
//   zoff          where the values of the columns start in `w`
//   copy_f/copy_i copy a whole state (root <-> working)
//   at_state      -1 when structural column j is basic, 0 when nonbasic at its lower bound, 1 at its upper
//   rcost         the reduced cost of column j in minimisation form (>= 0 at a lower bound, <= 0 at an upper bound when the state is optimal)

import solve.layout as l;
import solve.simplex as sx;
import solve.revised as rv;

pub fn wlen(eng: int, m: int, n: int, nnz: int) -> [] int {
    if eng == 1 {
        return rv.wf_len(m, n, nnz);
    }
    return m * (n + m) + 6 * (n + m) + m + 1;
}

pub fn wilen(eng: int, m: int, n: int, nnz: int) -> [] int {
    if eng == 1 {
        return rv.wi_len(m, n, nnz);
    }
    return m + 3 * (n + m) + 1;
}

pub fn filen(eng: int, m: int, nnz: int) -> [] int {
    if eng == 1 {
        return rv.ws_fi_len(m, nnz);
    }
    return 1;
}

pub fn fflen(eng: int, m: int, nnz: int) -> [] int {
    if eng == 1 {
        return rv.ws_ff_len(m, nnz);
    }
    return 1;
}

pub fn too_large(eng: int, m: int, n: int, nnz: int) -> [] bool {
    if eng == 1 {
        return rv.ws_too_large(m, nnz);
    }
    return m * (n + m) + 6 * (n + m) + m > sx.max_cells();
}

// 0, or (sparse engine) 4/5 when the root basis cannot be factorised.
pub fn load[&a, &b, &c, &d, &e, &f](eng: int, ints: &a [int], fl: &b [float], w: &!c [float], wi: &!d [int], fi: &!e [int], ff: &!f [float], m: int, n: int) -> [] int {
    if eng == 1 {
        return rv.ws_load(ints, fl, wi, w, fi, ff);
    }
    return sx.init_state(ints, fl, w, wi, m, n);
}

// The sparse engine only: the model with rows appended (and the rows of `rmap` removed, design.md 22.5) from the optimal state (ow, owi) of the model before. 0, or 4/5.
pub fn load_warm[&a, &b, &c, &d, &e, &f, &g, &h, &k](ints: &a [int], fl: &b [float], w: &!c [float], wi: &!d [int], fi: &!e [int], ff: &!f [float], ow: &g [float], owi: &h [int], rmap: &k [int]) -> [] int {
    return rv.ws_load_warm(ints, fl, wi, w, fi, ff, owi, ow, rmap);
}

// Iterations of this call go to stats[0]. Result codes: simplex.s_optimal, s_infeasible, s_limit, and for the sparse engine 4 (numerical) and 5 (pool).
pub fn run[&c, &d, &e, &f, &g](eng: int, w: &!c [float], wi: &!d [int], fi: &!e [int], ff: &!f [float], stats: &!g [int], m: int, n: int, limit: int) -> [] int {
    if eng == 1 {
        return rv.ws_run(wi, w, fi, ff, stats, limit);
    }
    return sx.dual_loop(w, wi, stats, m, n, limit);
}

// The bounds of structural column j become [lo, hi]. A nonbasic column keeps the side it sits on (so its reduced cost keeps its sign and the state stays dual feasible)
// and moves to the new bound on that side; a basic column keeps its value, which `refresh` and the dual simplex then repair.
pub fn set_bounds[&c, &d](eng: int, w: &!c [float], wi: &!d [int], m: int, n: int, j: int, lo: float, hi: float) -> [] int {
    if eng == 1 {
        return rv.ws_set_bounds(wi, w, j, lo, hi);
    }
    let big = n + m;
    let o_v = m * big + big;
    let o_l = o_v + big;
    let o_h = o_l + big;
    w[o_l + j] = lo;
    w[o_h + j] = hi;
    if wi[m + j] < 0 {
        if wi[m + big + j] == 0 {
            w[o_v + j] = lo;
        } else {
            w[o_v + j] = hi;
        }
    }
    return 0;
}

pub fn copied[&d](eng: int, wi: &!d [int]) -> [] int {
    if eng == 1 {
        return rv.ws_mark_copied(wi);
    }
    return 0;
}

// Dense: z_B(i) = -sum over the nonbasic columns of T[i][j] z_j. Sparse: duals and basic values by the factorisation (a new one after `copied`). 0, or 4/5.
pub fn refresh[&c, &d, &e, &f](eng: int, w: &!c [float], wi: &!d [int], fi: &!e [int], ff: &!f [float], m: int, n: int) -> [] int {
    if eng == 1 {
        return rv.ws_refresh(wi, w, fi, ff);
    }
    let big = n + m;
    let o_v = m * big + big;
    var i = 0;
    while i < m {
        var s = 0.0;
        var j = 0;
        while j < big {
            if wi[m + j] < 0 {
                s = s + w[i * big + j] * w[o_v + j];
            }
            j = j + 1;
        }
        w[o_v + wi[i]] = -s;
        i = i + 1;
    }
    return 0;
}

pub fn zoff[&d](eng: int, wi: &d [int], m: int, n: int) -> [] int {
    if eng == 1 {
        return rv.ws_zoff(wi);
    }
    return m * (n + m) + (n + m);
}

pub fn copy_f[&c, &d](dst: &!c [float], src: &d [float]) -> [] int {
    var k = 0;
    while k < len(src) {
        dst[k] = src[k];
        k = k + 1;
    }
    return 0;
}

pub fn copy_i[&c, &d](dst: &!c [int], src: &d [int]) -> [] int {
    var k = 0;
    while k < len(src) {
        dst[k] = src[k];
        k = k + 1;
    }
    return 0;
}

pub fn at_state[&c](eng: int, wi: &c [int], m: int, n: int, j: int) -> [] int {
    if eng == 1 {
        if wi[wi[9] + j] >= 0 {
            return 0 - 1;
        }
        return wi[wi[10] + j];
    }
    if wi[m + j] >= 0 {
        return 0 - 1;
    }
    return wi[m + n + m + j];
}

pub fn rcost[&c, &d](eng: int, w: &c [float], wi: &d [int], m: int, n: int, j: int) -> [] float {
    if eng == 1 {
        return w[wi[17] + j];
    }
    return w[m * (n + m) + j];
}
