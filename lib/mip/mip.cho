edition 7;

module solve.mip;

// Mixed-integer solving by branch and bound over the dense dual simplex (docs/design.md section 19).
//
// A node is (parent, column, lo, hi, bound, depth, direction, distance): the root's bounds intersected with the changes on the path to the root. The LP of a node is reached either
// by plunging (the child of the node just solved, in place) or by restoring (the root's optimal tableau, the path's bounds, `refresh`, the dual simplex). See lpeng.cho for the LP side.
// Everything is in minimisation form inside the search (z = sign * (c x + c0)) and converted at the end. Nothing here reads a clock or a hash: the same model and options give the same bytes.

import solve.cmir as cm;
import solve.cuts as cu;
import solve.heur as hu;
import solve.layout as l;
import solve.lpeng as le;
import solve.simplex as sx;

// results of `search`
pub fn r_optimal() -> [] int {
    return 0;
}

pub fn r_infeasible() -> [] int {
    return 1;
}

pub fn r_feasible() -> [] int {
    return 2;
}

pub fn r_unknown() -> [] int {
    return 3;
}

pub fn r_too_large() -> [] int {
    return 4;
}

pub fn r_numerical() -> [] int {
    return 5;
}

pub fn r_paused() -> [] int {
    return 6;
}

pub fn r_root() -> [] int {
    return 7;
}

pub fn max_node_limit() -> [] int {
    return 2000000;
}

fn mag(x: float) -> [] float {
    if x < 0.0 {
        return -x;
    }
    return x;
}

// A value within 1e-9 of zero is zero (the cuts leave noise of 1e-15 in continuous columns that the report would print).
fn snap(v: float) -> [] float {
    if v < 1e-9 && v > -1e-9 {
        return 0.0;
    }
    return v;
}

fn ffloor(v: float) -> [] float {
    if v > 1e15 || v < -1e15 {
        return v;
    }
    let t = float_of(truncate(v));
    if t > v {
        return t - 1.0;
    }
    return t;
}

fn fround(v: float) -> [] float {
    return ffloor(v + 0.5);
}

fn fmin(a: float, b: float) -> [] float {
    if a < b {
        return a;
    }
    return b;
}

fn fmax(a: float, b: float) -> [] float {
    if a > b {
        return a;
    }
    return b;
}

fn sense_sign[&a](ints: &a [int]) -> [] float {
    if ints[l.h_sense()] == 2 {
        return -1.0;
    }
    return 1.0;
}

// z = sign * (c x + c0) of the point v[base + col].
fn objective_at[&a, &b, &c](ints: &a [int], fl: &b [float], v: &c [float], base: int) -> [] float {
    var s = 0.0;
    if ints[l.h_sense()] != 0 {
        s = fl[l.obj_const(0)];
        var t = 0;
        while t < ints[l.h_obj_nnz()] {
            s = s + fl[l.obj_coef(t)] * v[base + ints[l.obj_col(t)]];
            t = t + 1;
        }
    }
    return sense_sign(ints) * s;
}

// Every row holds at the point v[base + col], to `tol` scaled by 1 + |rhs|.
fn rows_ok[&a, &b, &c](ints: &a [int], fl: &b [float], v: &c [float], base: int, tol: float) -> [] bool {
    var r = 0;
    while r < ints[l.h_ncons()] {
        var act = 0.0;
        var t = ints[l.row_start(r)];
        while t < ints[l.row_start(r + 1)] {
            act = act + fl[l.term_coef(t)] * v[base + ints[l.term_col(t)]];
            t = t + 1;
        }
        let rhs = fl[l.row_rhs(r)];
        let sc = tol * (1.0 + mag(rhs));
        let s = ints[l.row_sense(r)];
        if s == 0 && act > rhs + sc {
            return false;
        }
        if s == 1 && act < rhs - sc {
            return false;
        }
        if s == 2 && mag(act - rhs) > sc {
            return false;
        }
        r = r + 1;
    }
    return true;
}

// Whether every term of the objective is a whole number times an integer column and the constant is whole: then z only takes whole values.
fn objective_whole[&a, &b, &c](ints: &a [int], fl: &b [float], mi: &c [int], o_isint: int) -> [] bool {
    if ints[l.h_sense()] == 0 {
        return false;
    }
    if fl[l.obj_const(0)] != fround(fl[l.obj_const(0)]) {
        return false;
    }
    var t = 0;
    while t < ints[l.h_obj_nnz()] {
        let cf = fl[l.obj_coef(t)];
        if mi[o_isint + ints[l.obj_col(t)]] == 0 || cf != fround(cf) {
            return false;
        }
        t = t + 1;
    }
    return true;
}

// Whether a node whose relaxation has value z can be cut, given the incumbent.
fn prunable(z: float, have: bool, inc: float, whole: bool) -> [] bool {
    if !have {
        return false;
    }
    if whole {
        return z > inc - 1.0 + 1e-6;
    }
    return z >= inc - 1e-9 * (1.0 + mag(inc));
}

// Rounded points of the LP in w, each offered as an incumbent; returns true when one replaced it. `modes` is how many of the four roundings are tried: 0 every integer column to the
// nearest whole number (the others as the LP has them), 1 every fractional integer column up, 2 down, 3 by locks: up when only a decrease can break a row, down when only an increase
// can, the nearest otherwise (docs/design.md 19.8). The first alone is what the search offered before 19.8; the integral case still uses it alone, its caller reads tx afterwards.
fn offer[&a, &b, &c, &d, &e](ints: &a [int], fl: &b [float], w: &c [float], mf: &!d [float], mi: &e [int], m: int, n: int, o_v: int, o_tx: int, o_isint: int, o_inc: int, o_ix: int, o_ul: int, o_dl: int, inc_have: bool, whole: bool, modes: int) -> [] bool {
    var improved = false;
    var have2 = inc_have;
    var mode = 0;
    while mode < modes {
        var j = 0;
        while j < n {
            let v = w[o_v + j];
            if mi[o_isint + j] == 1 {
                var t = fround(v);
                if mag(v - t) > 1e-9 {
                    if mode == 1 {
                        t = ffloor(v) + 1.0;
                    } else if mode == 2 {
                        t = ffloor(v);
                    } else if mode == 3 {
                        if mi[o_ul + j] == 0 && mi[o_dl + j] > 0 {
                            t = ffloor(v) + 1.0;
                        } else if mi[o_dl + j] == 0 && mi[o_ul + j] > 0 {
                            t = ffloor(v);
                        }
                    }
                }
                mf[o_tx + j] = t;
            } else {
                mf[o_tx + j] = v;
            }
            j = j + 1;
        }
        if rows_ok(ints, fl, mf, o_tx, 1e-7) {
            let z = objective_at(ints, fl, mf, o_tx);
            if !have2 || z < mf[o_inc] - 1e-9 * (1.0 + mag(mf[o_inc])) {
                mf[o_inc] = z;
                j = 0;
                while j < n {
                    mf[o_ix + j] = mf[o_tx + j];
                    j = j + 1;
                }
                have2 = true;
                improved = true;
            }
        }
        mode = mode + 1;
    }
    return improved;
}

// For each column, how many rows an increase of it could break (mi[o_ul + j]) and how many a decrease could (mi[o_dl + j]).
fn locks[&a, &b, &c](ints: &a [int], fl: &b [float], mi: &!c [int], n: int, o_ul: int, o_dl: int) -> [] int {
    var r = 0;
    while r < ints[l.h_ncons()] {
        let s = ints[l.row_sense(r)];
        var t = ints[l.row_start(r)];
        while t < ints[l.row_start(r + 1)] {
            let a = fl[l.term_coef(t)];
            let j = ints[l.term_col(t)];
            if a != 0.0 {
                let up = s == 2 || s == 0 && a > 0.0 || s == 1 && a < 0.0;
                let dn = s == 2 || s == 1 && a > 0.0 || s == 0 && a < 0.0;
                if up {
                    mi[o_ul + j] = mi[o_ul + j] + 1;
                }
                if dn {
                    mi[o_dl + j] = mi[o_dl + j] + 1;
                }
            }
            t = t + 1;
        }
        r = r + 1;
    }
    return 0;
}

// The integer column to branch on, or -1 when every integer column is within `tol` of a whole number. mode 0: the fractional part closest to one half; mode 1: pseudo-costs.
fn pick_branch[&c, &d, &e](w: &c [float], mf: &d [float], mi: &e [int], m: int, n: int, o_v: int, o_isint: int, o_pcu: int, o_pcd: int, o_psu: int, o_psd: int, mode: int, tol: float) -> [] int {
    var best = 0 - 1;
    var bscore = 0.0;
    var au = 1.0;
    var ad = 1.0;
    if mode == 1 {
        var su = 0.0;
        var cu = 0;
        var sd = 0.0;
        var cd = 0;
        var j0 = 0;
        while j0 < n {
            su = su + mf[o_psu + j0];
            cu = cu + mi[o_pcu + j0];
            sd = sd + mf[o_psd + j0];
            cd = cd + mi[o_pcd + j0];
            j0 = j0 + 1;
        }
        if cu > 0 {
            au = su / float_of(cu);
        }
        if cd > 0 {
            ad = sd / float_of(cd);
        }
    }
    var j = 0;
    while j < n {
        if mi[o_isint + j] == 1 {
            let v = w[o_v + j];
            let f = v - ffloor(v);
            let dist = fmin(f, 1.0 - f);
            if dist > tol {
                var score = dist;
                if mode == 1 {
                    var eu = au;
                    var ed = ad;
                    if mi[o_pcu + j] > 0 {
                        eu = mf[o_psu + j] / float_of(mi[o_pcu + j]);
                    }
                    if mi[o_pcd + j] > 0 {
                        ed = mf[o_psd + j] / float_of(mi[o_pcd + j]);
                    }
                    score = fmax(ed * f, 1e-6) * fmax(eu * (1.0 - f), 1e-6);
                }
                if best < 0 || score > bscore {
                    best = j;
                    bscore = score;
                }
            }
        }
        j = j + 1;
    }
    return best;
}

// The least bound among the open nodes (1e300 when none).
fn open_min[&a, &b](mf: &a [float], mi: &b [int], o_bd: int, o_open: int, nopen: int) -> [] float {
    var best = 1e300;
    var k = 0;
    while k < nopen {
        let b = mf[o_bd + mi[o_open + k]];
        if b < best {
            best = b;
        }
        k = k + 1;
    }
    return best;
}

fn count_frac[&c, &e](w: &c [float], mi: &e [int], n: int, o_v: int, o_isint: int) -> [] int {
    var k = 0;
    var j = 0;
    while j < n {
        if mi[o_isint + j] == 1 {
            let v = w[o_v + j];
            if mag(v - fround(v)) > 1e-6 {
                k = k + 1;
            }
        }
        j = j + 1;
    }
    return k;
}

fn inplace_i(b: bool) -> [] int {
    if b {
        return 1;
    }
    return 0;
}

fn fmax_i(a: int, b: int) -> [] int {
    if a > b {
        return a;
    }
    return b;
}

fn fmin_i(a: int, b: int) -> [] int {
    if a < b {
        return a;
    }
    return b;
}

// The profile of docs/design.md 22.1.1 (printed as `stats.prof` under experiment bit 128; prof[k] is stats[10 + k]): stats[18] incumbent updates, [19] the node of the last, [20] its depth,
// [21 + 2i] and [22 + 2i] the node and 1000 times the value of the first five, [31] how many came from an integral LP.
fn prof_inc[&d](stats: &!d [int], nodes: int, depth: int, inc: float, kind: int) -> [] int {
    let k = stats[18];
    stats[18] = k + 1;
    stats[19] = nodes;
    stats[20] = depth;
    if k < 5 {
        stats[21 + 2 * k] = nodes;
        stats[22 + 2 * k] = truncate(inc * 1000.0);
    }
    stats[31] = stats[31] + kind;
    return 0;
}

// Takes the next node off the open list (mode 0 the most recent, mode 1 the least bound, ties to the older node), dropping those the incumbent cuts. Returns -1 when none is left.
// The new length of the list is in mi[o_nopen].
fn pick_open[&a, &b](mf: &a [float], mi: &!b [int], o_bd: int, o_open: int, o_nopen: int, mode: int, have: bool, inc: float, whole: bool) -> [] int {
    var found = 0 - 1;
    while found < 0 && mi[o_nopen] > 0 {
        let cnt = mi[o_nopen];
        var at = cnt - 1;
        if mode == 1 {
            var k = 0;
            at = 0;
            while k < cnt {
                let bk = mf[o_bd + mi[o_open + k]];
                let ba = mf[o_bd + mi[o_open + at]];
                if bk < ba || bk == ba && mi[o_open + k] < mi[o_open + at] {
                    at = k;
                }
                k = k + 1;
            }
        }
        let id = mi[o_open + at];
        mi[o_open + at] = mi[o_open + cnt - 1];
        mi[o_nopen] = cnt - 1;
        if !prunable(mf[o_bd + id], have, inc, whole) {
            found = id;
        }
    }
    return found;
}

// Reduced-cost fixing at the root (docs/design.md 19.8): with the root's optimal state (rw, rwi, value zroot) and an incumbent inc, a nonbasic integer column cannot move more than
// floor((inc - delta - zroot) / |d_j|) units away from its root bound in a solution that beats the incumbent, because z >= zroot + sum d_j (x_j - bound_j). The global bounds
// mf[o_l0 + j], mf[o_h0 + j] shrink accordingly; every node restored from now on starts from them. Returns how many columns were tightened.
fn rc_fix[&a, &b, &c, &d](eng: int, rw: &a [float], rwi: &b [int], mf: &!c [float], mi: &d [int], m: int, n: int, o_isint: int, o_l0: int, o_h0: int, zroot: float, inc: float, whole: bool) -> [] int {
    var delta = 1e-9 * (1.0 + mag(inc));
    if whole {
        delta = 1.0 - 1e-6;
    }
    let slack = inc - delta - zroot;
    var fixed = 0;
    if slack < 0.0 {
        return 0;
    }
    var j = 0;
    while j < n {
        if mi[o_isint + j] == 1 {
            let at = le.at_state(eng, rwi, m, n, j);
            let dj = le.rcost(eng, rw, rwi, m, n, j);
            if at == 0 && dj > 1e-9 {
                let nh = mf[o_l0 + j] + ffloor(slack / dj + 1e-9);
                if nh < mf[o_h0 + j] {
                    mf[o_h0 + j] = nh;
                    fixed = fixed + 1;
                }
            } else if at == 1 && dj < -1e-9 {
                let nl = mf[o_h0 + j] - ffloor(slack / (0.0 - dj) + 1e-9);
                if nl > mf[o_l0 + j] {
                    mf[o_l0 + j] = nl;
                    fixed = fixed + 1;
                }
            }
        }
        j = j + 1;
    }
    return fixed;
}

// Everything the search keeps, laid out in two slices (`mf`, `mi`) and addressed by these offsets. kcap is the capacity of the node arena.
// ctl (the driver's control, docs/design.md 22.1): 0 resume a paused search, 1 pause when this many nodes have been solved (-1 never), 2 start with the incumbent in x/fres, 3 the bounds
// of the columns are in sd[0..n) and sd[n..2n) (a sub-MIP), 4 keep an LP point every this many nodes in sd[2n + slot n ..] (0 never), 5 how many slots (a ring), 6 stop after the root LP and return its point in x and its value in fres[1]. On a pause the search is
// in the arrays and the incumbent in x/fres; a paused search is resumed with the same arrays.
fn core[&a, &b, &c, &d, &e, &f, &g, &k, &o, &p, &q, &r, &s1, &s2, &s3, &s4](ints: &a [int], fl: &b [float], w: &!c [float], wi: &!d [int], rw: &!e [float], rwi: &!f [int], mf: &!g [float], mi: &!k [int], x: &!o [float], stats: &!p [int], fres: &!q [float], opts: &r [int], kcap: int, m: int, n: int, eng: int, fi: &!s1 [int], ff: &!s2 [float], sd: &!s3 [float], ctl: &!s4 [int]) -> [] int {
    let big = n + m;
    var o_v = 0;
    let nl = opts[1];
    let sel = opts[2];
    let bmode = opts[3];
    let exper = opts[4];
    // float offsets
    let o_lo = 0;
    let o_hi = kcap;
    let o_bd = 2 * kcap;
    let o_fr = 3 * kcap;
    let c0 = 4 * kcap;
    let o_bl = c0;
    let o_bh = c0 + n;
    let o_l0 = c0 + 2 * n;
    let o_h0 = c0 + 3 * n;
    let o_psu = c0 + 4 * n;
    let o_psd = c0 + 5 * n;
    let o_ix = c0 + 6 * n;
    let o_tx = c0 + 7 * n;
    let o_inc = c0 + 8 * n;
    // int offsets
    let o_par = 0;
    let o_col = kcap;
    let o_dep = 2 * kcap;
    let o_dir = 3 * kcap;
    let o_open = 4 * kcap;
    let ic = 5 * kcap;
    let o_isint = ic;
    let o_pcu = ic + n;
    let o_pcd = ic + 2 * n;
    let o_nopen = ic + 3 * n;
    let o_ul = ic + 3 * n + 1;
    let o_dl = ic + 4 * n + 1;
    let o_sv = ic + 5 * n + 8;
    let o_svf = c0 + 8 * n + 4;
    // per-column data from the checked model
    var k2 = 0;
    while k2 < ints[l.h_nsym()] {
        if ints[l.sym_class(k2)] == 1 {
            var off = 0;
            while off < ints[l.sym_size(k2)] {
                let j = ints[l.sym_base(k2)] + off;
                mf[o_l0 + j] = fl[l.sym_lo(k2)];
                mf[o_h0 + j] = fl[l.sym_hi(k2)];
                mf[o_bl + j] = fl[l.sym_lo(k2)];
                mf[o_bh + j] = fl[l.sym_hi(k2)];
                if ints[l.sym_kind(k2)] < 2 {
                    mi[o_isint + j] = 1;
                }
                off = off + 1;
            }
        }
        k2 = k2 + 1;
    }
    if ctl[3] == 1 {
        var jo = 0;
        while jo < n {
            mf[o_l0 + jo] = sd[jo];
            mf[o_h0 + jo] = sd[n + jo];
            mf[o_bl + jo] = sd[jo];
            mf[o_bh + jo] = sd[n + jo];
            jo = jo + 1;
        }
    }
    locks(ints, fl, mi, n, o_ul, o_dl);
    var whole = objective_whole(ints, fl, mi, o_isint);
    if exper % 2 == 1 {
        whole = false;
    }
    let sign = sense_sign(ints);
    let dcap = 100 * big + 1000;
    var have = false;
    var inc = 0.0;
    var iters = 0;
    var nodes = 0;
    var branched = 0;
    var reason = 0;
    var finished = false;
    var extra = 1e300;
    var zroot = 0.0;
    var rcfix = 0;
    var st = 0;
    var z = 0.0;
    var cur = 0;
    var running = true;
    var paused = false;
    let resume = ctl[0] == 1;
    if ctl[2] == 1 {
        have = true;
        inc = sign * fres[0];
        mf[o_inc] = inc;
        var ji = 0;
        while ji < n {
            mf[o_ix + ji] = x[ji];
            ji = ji + 1;
        }
    }
    if resume {
        cur = mi[o_sv];
        st = mi[o_sv + 1];
        nodes = mi[o_sv + 2];
        branched = mi[o_sv + 3];
        iters = mi[o_sv + 4];
        rcfix = mi[o_sv + 5];
        z = mf[o_svf];
        zroot = mf[o_svf + 1];
        o_v = le.zoff(eng, wi, m, n);
        if have && exper / 16 % 2 == 0 {
            rcfix = rcfix + rc_fix(eng, rw, rwi, mf, mi, m, n, o_isint, o_l0, o_h0, zroot, inc, whole);
        }
    } else {
        mi[o_nopen] = 0;
        mi[o_par] = 0 - 1;
        mi[o_col] = 0 - 1;
        mf[o_bd] = -1e300;
    }
    // ---- the root
    if nl < 1 && !resume {
        reason = 1;
        running = false;
        extra = -1e300;
    }
    if running && !resume {
        let remaining = opts[0] - iters;
        if opts[0] >= 0 && remaining <= 0 {
            reason = 2;
            running = false;
            extra = -1e300;
        } else {
            var lim = dcap;
            if opts[0] >= 0 && remaining < dcap {
                lim = remaining;
            }
            st = le.load(eng, ints, fl, w, wi, fi, ff, m, n);
            if eng == 0 {
                st = 0;
            }
            o_v = le.zoff(eng, wi, m, n);
            if st == 0 && ctl[3] == 1 {
                var jr = 0;
                while jr < n {
                    le.set_bounds(eng, w, wi, m, n, jr, mf[o_l0 + jr], mf[o_h0 + jr]);
                    jr = jr + 1;
                }
                st = le.refresh(eng, w, wi, fi, ff, m, n);
            }
            if st == 0 {
                st = le.run(eng, w, wi, fi, ff, stats, m, n, lim);
                iters = iters + stats[0];
            }
            nodes = 1;
            if st > sx.s_limit() {
                reason = 4;
                running = false;
                extra = -1e300;
            } else if st == sx.s_limit() {
                reason = 3;
                if opts[0] >= 0 && opts[0] - 0 <= dcap {
                    reason = 2;
                }
                running = false;
                extra = -1e300;
            } else if st == sx.s_optimal() {
                le.copy_f(rw, w);
                le.copy_i(rwi, wi);
                z = objective_at(ints, fl, w, o_v);
                zroot = z;
            }
        }
    }
    if ctl[6] == 1 && running && st == sx.s_optimal() {
        // root only (the cut rounds of docs/design.md 22.1): hand back the LP point and its value
        var jx = 0;
        while jx < n {
            x[jx] = w[o_v + jx];
            jx = jx + 1;
        }
        fres[1] = sign * z;
        stats[0] = iters;
        stats[3] = 1;
        return r_root();
    }
    // ---- the loop: process the node `cur` whose LP was just solved (status st, value z), then choose and solve the next
    while running {
        var plunge = 0 - 1;
        if st == sx.s_optimal() {
            let cf = count_frac(w, mi, n, o_v, o_isint);
            if nodes == 1 {
                stats[60] = cf;
                stats[61] = truncate(z * 1000.0);
            }
            stats[62] = stats[62] + cf;
        }
        if st == sx.s_infeasible() {
            stats[15] = stats[15] + 1;
        }
        if st == sx.s_optimal() && prunable(z, have, inc, whole) {
            stats[16] = stats[16] + 1;
        }
        if st == sx.s_optimal() {
            if cur > 0 && bmode == 1 {
                let dl = fmax(z - mf[o_bd + cur], 0.0) / mf[o_fr + cur];
                let cc = mi[o_col + cur];
                if mi[o_dir + cur] == 0 {
                    mf[o_psd + cc] = mf[o_psd + cc] + dl;
                    mi[o_pcd + cc] = mi[o_pcd + cc] + 1;
                } else {
                    mf[o_psu + cc] = mf[o_psu + cc] + dl;
                    mi[o_pcu + cc] = mi[o_pcu + cc] + 1;
                }
            }
            if !prunable(z, have, inc, whole) {
                var jb = pick_branch(w, mf, mi, m, n, o_v, o_isint, o_pcu, o_pcd, o_psu, o_psd, bmode, 1e-6);
                if jb < 0 {
                    // integral: offer the rounded point; if its rows fail at the tight tolerance, branch on the least integral column instead
                    stats[17] = stats[17] + 1;
                    if offer(ints, fl, w, mf, mi, m, n, o_v, o_tx, o_isint, o_inc, o_ix, o_ul, o_dl, have, whole, 1) {
                        have = true;
                        inc = mf[o_inc];
                        stats[6] = stats[6] + 1;
                        prof_inc(stats, nodes, mi[o_dep + cur], inc, 1);
                        if exper / 16 % 2 == 0 {
                            rcfix = rcfix + rc_fix(eng, rw, rwi, mf, mi, m, n, o_isint, o_l0, o_h0, zroot, inc, whole);
                        }
                    } else if !rows_ok(ints, fl, mf, o_tx, 1e-7) {
                        jb = pick_branch(w, mf, mi, m, n, o_v, o_isint, o_pcu, o_pcd, o_psu, o_psd, 0, 1e-9);
                    }
                } else if exper / 2 % 2 == 0 && (mi[o_dep + cur] <= 8 || !have) {
                    if offer(ints, fl, w, mf, mi, m, n, o_v, o_tx, o_isint, o_inc, o_ix, o_ul, o_dl, have, whole, 4) {
                        have = true;
                        inc = mf[o_inc];
                        stats[6] = stats[6] + 1;
                        prof_inc(stats, nodes, mi[o_dep + cur], inc, 0);
                        if exper / 16 % 2 == 0 {
                            rcfix = rcfix + rc_fix(eng, rw, rwi, mf, mi, m, n, o_isint, o_l0, o_h0, zroot, inc, whole);
                        }
                    }
                }
                if jb >= 0 && !prunable(z, have, inc, whole) {
                    if ctl[4] > 0 && nodes % ctl[4] == 0 {
                        let slot = stats[71] % ctl[5];
                        var jg = 0;
                        while jg < n {
                            sd[2 * n + slot * n + jg] = w[o_v + jg];
                            jg = jg + 1;
                        }
                        stats[71] = stats[71] + 1;
                    }
                    let v = w[o_v + jb];
                    let fv = ffloor(v);
                    let idn = stats[7] + 1;
                    let idu = stats[7] + 2;
                    if idu < kcap {
                        stats[7] = stats[7] + 2;
                        branched = branched + 1;
                        mi[o_par + idn] = cur;
                        mi[o_col + idn] = jb;
                        mi[o_dep + idn] = mi[o_dep + cur] + 1;
                        mi[o_dir + idn] = 0;
                        mf[o_lo + idn] = mf[o_bl + jb];
                        mf[o_hi + idn] = fv;
                        mf[o_bd + idn] = z;
                        mf[o_fr + idn] = fmax(v - fv, 1e-9);
                        mi[o_par + idu] = cur;
                        mi[o_col + idu] = jb;
                        mi[o_dep + idu] = mi[o_dep + cur] + 1;
                        mi[o_dir + idu] = 1;
                        mf[o_lo + idu] = fv + 1.0;
                        mf[o_hi + idu] = mf[o_bh + jb];
                        mf[o_bd + idu] = z;
                        mf[o_fr + idu] = fmax(fv + 1.0 - v, 1e-9);
                        var first = idu;
                        var second = idn;
                        if v - fv < 0.5 {
                            first = idn;
                            second = idu;
                        }
                        if exper / 4 % 2 == 1 {
                            let tmp = first;
                            first = second;
                            second = tmp;
                        }
                        mi[o_open + mi[o_nopen]] = second;
                        mi[o_nopen] = mi[o_nopen] + 1;
                        plunge = first;
                    } else {
                        reason = 1;
                        running = false;
                        extra = z;
                    }
                }
            }
        }
        if running {
            var nxt = plunge;
            let inplace = plunge >= 0;
            if !inplace {
                var smode = sel;
                if sel == 2 {
                    smode = 0;
                    if have {
                        smode = 1;
                    }
                }
                nxt = pick_open(mf, mi, o_bd, o_open, o_nopen, smode, have, inc, whole);
            }
            if nxt < 0 {
                finished = true;
                running = false;
            } else if nodes >= nl {
                reason = 1;
                extra = mf[o_bd + nxt];
                running = false;
            } else {
                let remaining = opts[0] - iters;
                if opts[0] >= 0 && remaining <= 0 {
                    reason = 2;
                    extra = mf[o_bd + nxt];
                    running = false;
                } else {
                    var empty = false;
                    if inplace {
                        let cc = mi[o_col + nxt];
                        mf[o_bl + cc] = fmax(mf[o_bl + cc], mf[o_lo + nxt]);
                        mf[o_bh + cc] = fmin(mf[o_bh + cc], mf[o_hi + nxt]);
                        if mf[o_bl + cc] > mf[o_bh + cc] {
                            empty = true;
                        }
                        le.set_bounds(eng, w, wi, m, n, cc, mf[o_bl + cc], mf[o_bh + cc]);
                    } else {
                        if exper / 2097152 % 2 == 0 {
                            le.copy_f(w, rw);
                            le.copy_i(wi, rwi);
                            le.copied(eng, wi);
                        }
                        var j = 0;
                        while j < n {
                            mf[o_bl + j] = mf[o_l0 + j];
                            mf[o_bh + j] = mf[o_h0 + j];
                            j = j + 1;
                        }
                        var v = nxt;
                        while v > 0 {
                            let cc = mi[o_col + v];
                            mf[o_bl + cc] = fmax(mf[o_bl + cc], mf[o_lo + v]);
                            mf[o_bh + cc] = fmin(mf[o_bh + cc], mf[o_hi + v]);
                            v = mi[o_par + v];
                        }
                        j = 0;
                        while j < n {
                            if mf[o_bl + j] > mf[o_bh + j] {
                                empty = true;
                            }
                            le.set_bounds(eng, w, wi, m, n, j, mf[o_bl + j], mf[o_bh + j]);
                            j = j + 1;
                        }
                    }
                    cur = nxt;
                    nodes = nodes + 1;
                    stats[10 + (1 - inplace_i(inplace))] = stats[10 + (1 - inplace_i(inplace))] + 1;
                    if !inplace {
                        var pv = nxt;
                        while pv > 0 {
                            stats[14] = stats[14] + 1;
                            pv = mi[o_par + pv];
                        }
                    }
                    stats[32 + fmin_i(mi[o_dep + nxt] / 4, 15)] = stats[32 + fmin_i(mi[o_dep + nxt] / 4, 15)] + 1;
                    if empty {
                        st = sx.s_infeasible();
                    } else {
                        st = le.refresh(eng, w, wi, fi, ff, m, n);
                        var lim = dcap;
                        if opts[0] >= 0 && remaining < dcap {
                            lim = remaining;
                        }
                        if st == 0 {
                            st = le.run(eng, w, wi, fi, ff, stats, m, n, lim);
                            iters = iters + stats[0];
                            stats[12 + (1 - inplace_i(inplace))] = stats[12 + (1 - inplace_i(inplace))] + stats[0];
                        }
                        if st > sx.s_limit() {
                            reason = 4;
                            extra = mf[o_bd + nxt];
                            running = false;
                        } else if st == sx.s_limit() {
                            reason = 3;
                            if opts[0] >= 0 && remaining <= dcap {
                                reason = 2;
                            }
                            extra = mf[o_bd + nxt];
                            running = false;
                        } else if st == sx.s_optimal() {
                            z = objective_at(ints, fl, w, o_v);
                        }
                    }
                }
            }
        }
        if running && ctl[1] >= 0 && nodes >= ctl[1] && nodes < nl {
            paused = true;
            running = false;
        }
    }
    stats[0] = iters;
    stats[3] = nodes;
    stats[4] = reason;
    stats[5] = branched;
    if paused {
        mi[o_sv] = cur;
        mi[o_sv + 1] = st;
        mi[o_sv + 2] = nodes;
        mi[o_sv + 3] = branched;
        mi[o_sv + 4] = iters;
        mi[o_sv + 5] = rcfix;
        mf[o_svf] = z;
        mf[o_svf + 1] = zroot;
        if have {
            fres[0] = sign * inc;
            var jp = 0;
            while jp < n {
                x[jp] = mf[o_ix + jp];
                jp = jp + 1;
            }
        }
        return r_paused();
    }
    var code = r_unknown();
    if reason == 4 {
        stats[0] = iters;
        return r_numerical();
    }
    var bound = fmin(extra, open_min(mf, mi, o_bd, o_open, mi[o_nopen]));
    if finished {
        if have {
            code = r_optimal();
            bound = inc;
        } else {
            code = r_infeasible();
        }
    } else if have {
        code = r_feasible();
        bound = fmin(bound, inc);
    }
    if have {
        fres[0] = sign * inc;
        var j = 0;
        while j < n {
            x[j] = snap(mf[o_ix + j]);
            j = j + 1;
        }
    }
    fres[1] = 1e300;
    if bound > -1e299 && bound < 1e299 {
        fres[1] = sign * bound;
    }
    return code;
}

// Solves the MIP of the checked model. `x` (length at least n) gets the incumbent; `fres` (length 2) the objective and the best bound, both in the model's own sense (a bound of
// 1e300 means none is known). `stats`: 0 iterations, 1 rows, 2 columns, 3 nodes whose LP was solved, 4 limit (0 none, 1 nodes, 2 iterations, 3 lp-limit), 5 nodes branched,
// 6 incumbent updates, 7 nodes created minus one (internal). `opts`: 0 iteration budget (-1 none), 1 node limit, 2 node selection (0 depth, 1 best, 2 hybrid: depth until the first incumbent, then best bound), 3 branching (0 fractional,
// 1 pseudo-cost), 4 experiment bits (1 no objective-integrality cut, 2 no rounding heuristic, 4 plunge to the far child, 8 no implied cuts, 16 no reduced-cost fixing, 32 no pausing and no RINS, 64 no MIR cuts, 128 print the profile, 256 the MIR rounds before the search instead of after its first 300 nodes), 5 LP engine (0 dense, 1 sparse revised; docs/design.md 19.6).

// One run of `core` to its end on its own arrays, with a node limit and the control of a sub-MIP (docs/design.md 22.1): the incumbent in x/fres, the bounds in sd.
fn sub_in[&h, &a, &b, &c, &d, &e, &f, &g, &k](heap: &!h Heap, ints: &a [int], fl: &b [float], x: &!c [float], stats: &!d [int], fres: &!e [float], opts: &f [int], sd: &!g [float], ctl: &!k [int]) -> [heap] int {
    let n = ints[l.h_nvars()];
    let m = ints[l.h_ncons()];
    let eng = opts[5];
    let nnz = ints[l.row_start(m)];
    let kcap = 2 * opts[1] + 2;
    let w = box_slice(heap, le.wlen(eng, m, n, nnz), 0.0);
    let wi = box_slice(heap, le.wilen(eng, m, n, nnz), 0);
    let rw = box_slice(heap, le.wlen(eng, m, n, nnz), 0.0);
    let rwi = box_slice(heap, le.wilen(eng, m, n, nnz), 0);
    let fi = box_slice(heap, le.filen(eng, m, nnz), 0);
    let ff = box_slice(heap, le.fflen(eng, m, nnz), 0.0);
    let mf = box_slice(heap, 4 * kcap + 8 * n + 24, 0.0);
    let mi = box_slice(heap, 5 * kcap + 5 * n + 24, 0);
    var code = 0;
    borrow mut w as &!w1 in {
        borrow mut wi as &!w2 in {
            borrow mut rw as &!w3 in {
                borrow mut rwi as &!w4 in {
                    borrow mut mf as &!w5 in {
                        borrow mut mi as &!w6 in {
                            borrow mut fi as &!w7 in {
                                borrow mut ff as &!w8 in {
                                    code = core(ints, fl, contents(w1), contents(w2), contents(w3), contents(w4), contents(w5), contents(w6), x, stats, fres, opts, kcap, m, n, eng, contents(w7), contents(w8), sd, ctl);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    unbox_slice(heap, mi);
    unbox_slice(heap, mf);
    unbox_slice(heap, ff);
    unbox_slice(heap, fi);
    unbox_slice(heap, rwi);
    unbox_slice(heap, rw);
    unbox_slice(heap, wi);
    unbox_slice(heap, w);
    return code;
}

fn improves(sign: float, a: float, than: float) -> [] bool {
    return sign * a < sign * than - 1e-9 * (1.0 + mag(than));
}

// The main search with RINS between its slices (docs/design.md 22.1). `core` is run to the first pause (after `pause` nodes); then, with an incumbent, for each of the LP points it kept
// (a ring of `gcount`, one every `gstep` nodes) a sub-MIP with the integer columns on which the point and the incumbent agree fixed (RINS) runs for a few nodes; an improved incumbent is
// handed back to the paused search, which resumes with it (its open nodes are cut by the new value). The pause interval triples each time. Sub-MIPs are separate runs of `core` (no recursion).
// stats[72] counts sub-MIPs, [73] improvements, [74] their nodes, [75] their iterations.
fn drive[&h, &a, &b, &c, &d, &e, &f, &g1, &g2, &g3, &g4, &g5, &g6, &g7, &g8, &g9, &g10](heap: &!h Heap, ints: &a [int], fl: &b [float], w: &!c [float], wi: &!d [int], rw: &!e [float], rwi: &!f [int], mf: &!g1 [float], mi: &!g2 [int], x: &!g3 [float], stats: &!g4 [int], fres: &!g5 [float], opts: &g6 [int], kcap: int, m: int, n: int, eng: int, fi: &!g7 [int], ff: &!g8 [float], sd: &!g9 [float], ctl: &!g10 [int], inherit: bool, mirpend: bool) -> [heap] int {
    let sign = sense_sign(ints);
    let gcount = 6;
    let ik = box_slice(heap, n + 1, 0);
    let ssd = box_slice(heap, 2 * n + 8, 0.0);
    let sx2 = box_slice(heap, n + 1, 0.0);
    let sfr = box_slice(heap, 2, 0.0);
    let sst = box_slice(heap, 80, 0);
    let sct = box_slice(heap, 8, 0);
    let sop = box_slice(heap, 8, 0);
    var pause = 300;
    if opts[0] >= 0 || opts[4] / 32 % 2 == 1 {
        pause = 0 - 1;
    }
    ctl[0] = 0;
    ctl[1] = pause;
    ctl[2] = 0;
    if inherit {
        ctl[2] = 1;
    }
    ctl[3] = 0;
    ctl[4] = 25;
    ctl[5] = gcount;
    ctl[6] = 0;
    var code = 0;
    var haveinc = inherit;
    var sub_iters = 0;
    var stop = false;
    borrow mut ik as &!k1 in {
        hu.col_bounds(ints, fl, sd, contents(k1), n);
        let kv = contents(k1);
        let nint = hu.count_int(kv, n);
        code = core(ints, fl, w, wi, rw, rwi, mf, mi, x, stats, fres, opts, kcap, m, n, eng, fi, ff, sd, ctl);
        if code == r_paused() && mirpend {
            stop = true;
        }
        while code == r_paused() && !stop {
            haveinc = haveinc || stats[6] > 0;
            let cnt = fmin_i(stats[71], gcount);
            stats[71] = 0;
            if haveinc {
                var g = 0;
                while g < cnt {
                    borrow mut ssd as &!s1 in {
                        borrow mut sx2 as &!s2 in {
                            borrow mut sfr as &!s3 in {
                                borrow mut sst as &!s4 in {
                                    borrow mut sct as &!s5 in {
                                        borrow mut sop as &!s6 in {
                                            let fixed = hu.rins_bounds(kv, sd, sd, 2 * n + g * n, x, contents(s1), n);
                                            if fixed * 10 >= nint * 3 && fixed < nint {
                                                let xv = contents(s2);
                                                var j = 0;
                                                while j < n {
                                                    xv[j] = x[j];
                                                    j = j + 1;
                                                }
                                                let fv = contents(s3);
                                                fv[0] = fres[0];
                                                let cv = contents(s5);
                                                cv[0] = 0;
                                                cv[1] = 0 - 1;
                                                cv[2] = 1;
                                                cv[3] = 1;
                                                cv[4] = 0;
                                                cv[5] = 1;
                                                cv[6] = 0;
                                                let ov = contents(s6);
                                                ov[0] = 0 - 1;
                                                ov[1] = fmax_i(50, fmin_i(1000, stats[3] / gcount));

                                                ov[2] = 2;
                                                ov[3] = 1;
                                                ov[4] = opts[4];
                                                ov[5] = eng;
                                                let sv = contents(s4);
                                                var q = 0;
                                                while q < 80 {
                                                    sv[q] = 0;
                                                    q = q + 1;
                                                }
                                                let c2 = sub_in(heap, ints, fl, xv, sv, fv, ov, contents(s1), cv);
                                                stats[72] = stats[72] + 1;
                                                stats[74] = stats[74] + sv[3];
                                                sub_iters = sub_iters + sv[0];
                                                if c2 <= r_feasible() && improves(sign, fv[0], fres[0]) {
                                                    fres[0] = fv[0];
                                                    q = 0;
                                                    while q < n {
                                                        x[q] = xv[q];
                                                        q = q + 1;
                                                    }
                                                    stats[73] = stats[73] + 1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    g = g + 1;
                }
            }
            ctl[0] = 1;
            ctl[1] = ctl[1] * 3;
            ctl[2] = 0;
            if haveinc {
                ctl[2] = 1;
            }
            code = core(ints, fl, w, wi, rw, rwi, mf, mi, x, stats, fres, opts, kcap, m, n, eng, fi, ff, sd, ctl);
        }
    }
    stats[75] = sub_iters;
    stats[0] = stats[0] + sub_iters;
    unbox_slice(heap, sop);
    unbox_slice(heap, sct);
    unbox_slice(heap, sst);
    unbox_slice(heap, sfr);
    unbox_slice(heap, sx2);
    unbox_slice(heap, ssd);
    unbox_slice(heap, ik);
    return code;
}

fn search_in[&h, &a, &b, &c, &d, &e, &f](heap: &!h Heap, ints: &a [int], fl: &b [float], x: &!c [float], stats: &!d [int], fres: &!e [float], opts: &f [int], m_report: int, inherit: bool, mirpend: bool) -> [heap] int {
    let n = ints[l.h_nvars()];
    let m = ints[l.h_ncons()];
    stats[0] = 0;
    stats[1] = m_report;
    stats[2] = n;
    stats[3] = 0;
    stats[4] = 0;
    stats[5] = 0;
    stats[6] = 0;
    stats[7] = 0;
    stats[71] = 0;
    stats[72] = 0;
    stats[73] = 0;
    stats[74] = 0;
    stats[75] = 0;
    if !inherit {
        fres[0] = 0.0;
    }
    fres[1] = 1e300;
    let eng = opts[5];
    let nnz = ints[l.row_start(m)];
    if le.too_large(eng, m, n, nnz) {
        return r_too_large();
    }
    let kcap = 2 * opts[1] + 2;
    let w = box_slice(heap, le.wlen(eng, m, n, nnz), 0.0);
    let wi = box_slice(heap, le.wilen(eng, m, n, nnz), 0);
    let rw = box_slice(heap, le.wlen(eng, m, n, nnz), 0.0);
    let rwi = box_slice(heap, le.wilen(eng, m, n, nnz), 0);
    let fi = box_slice(heap, le.filen(eng, m, nnz), 0);
    let ff = box_slice(heap, le.fflen(eng, m, nnz), 0.0);
    let mf = box_slice(heap, 4 * kcap + 8 * n + 24, 0.0);
    let mi = box_slice(heap, 5 * kcap + 5 * n + 24, 0);
    let sd = box_slice(heap, 8 * n + 8, 0.0);
    let ctl = box_slice(heap, 8, 0);
    var code = 0;
    borrow mut w as &!w1 in {
        borrow mut wi as &!w2 in {
            borrow mut rw as &!w3 in {
                borrow mut rwi as &!w4 in {
                    borrow mut mf as &!w5 in {
                        borrow mut mi as &!w6 in {
                            borrow mut fi as &!w7 in {
                                borrow mut ff as &!w8 in {
                                    borrow mut sd as &!w9 in {
                                        borrow mut ctl as &!w10 in {
                                            code = drive(heap, ints, fl, contents(w1), contents(w2), contents(w3), contents(w4), contents(w5), contents(w6), x, stats, fres, opts, kcap, m, n, eng, contents(w7), contents(w8), contents(w9), contents(w10), inherit, mirpend);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    unbox_slice(heap, ctl);
    unbox_slice(heap, sd);
    unbox_slice(heap, mi);
    unbox_slice(heap, mf);
    unbox_slice(heap, ff);
    unbox_slice(heap, fi);
    unbox_slice(heap, rwi);
    unbox_slice(heap, rw);
    unbox_slice(heap, wi);
    unbox_slice(heap, w);
    return code;
}

// bas[i] = 1 when the logical of row i is basic in the state wi (rows 0..mo).
fn basic_flags[&a, &b](wi: &a [int], n: int, mo: int, bas: &!b [int]) -> [] int {
    var i = 0;
    while i < mo {
        if wi[wi[9] + n + i] >= 0 {
            bas[i] = 1;
        } else {
            bas[i] = 0;
        }
        i = i + 1;
    }
    return 0;
}

// One LP of the cut rounds on the sparse engine (design.md 22.3): the model (ints, fl) loaded cold, or, with `warm`, from the optimal state (ow, owi) of the model it grew from, and solved by the dual
// simplex. The point goes to x[0..n), the minimised value z to x[n] and its value in the model's sense to fres[1]; st[0] is the iterations. Returns the engine's code (sx.s_optimal() when it solved).
fn lp_round[&a, &b, &c, &d, &e, &f, &g, &k, &p, &q, &r, &u](ints: &a [int], fl: &b [float], x: &!c [float], fres: &!d [float], st: &!e [int], warm: bool, ow: &f [float], owi: &g [int], rmap: &u [int], w: &!k [float], wi: &!p [int], fi: &!q [int], ff: &!r [float]) -> [] int {
    let n = ints[l.h_nvars()];
    let m = ints[l.h_ncons()];
    st[0] = 0;
    var code = 0;
    if warm {
        code = le.load_warm(ints, fl, w, wi, fi, ff, ow, owi, rmap);
        if code != 0 {
            // a basis that does not fit (or does not factorise): the same model from the slack basis
            code = le.load(1, ints, fl, w, wi, fi, ff, m, n);
        }
    } else {
        code = le.load(1, ints, fl, w, wi, fi, ff, m, n);
    }
    if code == 0 {
        code = le.run(1, w, wi, fi, ff, st, m, n, 1000000000);
    }
    if code == sx.s_optimal() {
        let o_v = le.zoff(1, wi, m, n);
        var j = 0;
        while j < n {
            x[j] = w[o_v + j];
            j = j + 1;
        }
        x[n] = objective_at(ints, fl, w, o_v);
        fres[1] = sense_sign(ints) * x[n];
    }
    return code;
}

// The MIR cut rounds of docs/design.md 22.1 on the copy (ints2, fl2) of the model, which already holds its implied cuts: solve the root LP, separate from its point (lib/mip/cmir.cho), append the
// best cuts as rows, and again, each LP from the optimal basis of the one before (22.3; experiment bit 1024 solves each from the slack basis, bit 512 solves each both ways and counts the
// disagreements); stop when no cut is violated, after 300 rounds, after 150 rounds in a row in which the bound did not move by 1e-9 relative, or when the model with the new rows would no longer fit
// the engine (the rounds use the sparse engine whatever the search uses: the dense one costs m (n + m) per pivot); then drop the cut rows that are not tight at the final point.
// stats[76] rounds, [77] cuts found, [78] cuts kept, [79] iterations of the rounds, [80] rounds solved warm, [81] disagreements found by bit 512, [82] iterations of the cold solves of bit 512, [83] cold retries after a warm vertex gave no cut.
// Returns the number of rows kept.
fn mir_rounds[&h, &b, &c, &d, &e](heap: &!h Heap, ints2: &!b [int], fl2: &!c [float], opts: &d [int], stats: &!e [int]) -> [heap] int {
    let n = ints2[l.h_nvars()];
    let m0 = ints2[l.h_ncons()];
    var mcap = m0 + 4000;
    if mcap > l.maxrows() {
        mcap = l.maxrows();
    }
    var nnzcap = ints2[l.row_start(m0)] + 300000;
    if nnzcap > l.maxnz() {
        nnzcap = l.maxnz();
    }
    let warm_on = opts[4] / 1024 % 2 == 0;
    let check = opts[4] / 512 % 2 == 1;
    let si = box_slice(heap, cm.si_len(n, nnzcap), 0);
    let sf = box_slice(heap, cm.sf_len(n, mcap), 0.0);
    let xs = box_slice(heap, n + 1, 0.0);
    let xc = box_slice(heap, n + 1, 0.0);
    let sfr = box_slice(heap, 2, 0.0);
    let sst = box_slice(heap, 80, 0);
    let sag = box_slice(heap, mcap + 8, 0);
    let sbs = box_slice(heap, mcap + 8, 0);
    let srm = box_slice(heap, mcap + 8, 0);
    // aging is opt-in (experiment bit 65536, design.md 22.5): the default keeps every cut to the end, as 22.3 does
    var capf = 2;
    if opts[4] / 131072 % 8 > 0 {
        capf = opts[4] / 131072 % 8;
    }
    var agelim = 1000000;
    var stalllim = 150;
    if opts[4] / 65536 % 2 == 1 {
        agelim = 8;
        // with aging the bound may stall for a while (a cut removed is found again), so the rounds are given the whole 300
        stalllim = 300;
        if opts[4] / 4096 % 16 > 0 {
            agelim = opts[4] / 4096 % 16;
        }
    }
    var pw = box_slice(heap, 1, 0.0);
    var pwi = box_slice(heap, 1, 0);
    var kept = 0;
    var have = false;
    borrow mut si as &!s1 in {
        borrow mut sf as &!s2 in {
            borrow mut xs as &!s3 in {
                borrow mut xc as &!s9 in {
                    borrow mut sfr as &!s4 in {
                        borrow mut sst as &!s5 in {
                            let siv = contents(s1);
                            let sfv = contents(s2);
                            let xv = contents(s3);
                            let xcv = contents(s9);
                            let fv = contents(s4);
                            let stv = contents(s5);
                            borrow mut sag as &!s10 in {
                            borrow mut sbs as &!s11 in {
                            borrow mut srm as &!s12 in {
                            let agv = contents(s10);
                            let bsv = contents(s11);
                            let rmv = contents(s12);
                            cm.colinfo(ints2, fl2, siv, sfv, n);
                            var round = 0;
                            var stall = 0;
                            var last = 0.0;
                            var found = 0;
                            var go = true;
                            var fin = false;
                            var okc = false;
                            var retry = false;
                            while go {
                                let mcur = ints2[l.h_ncons()];
                                let nz = ints2[l.row_start(mcur)];
                                if le.too_large(1, mcur + 100, n, nz + 40000) {
                                    go = false;
                                    okc = false;
                                } else {
                                    let nw = box_slice(heap, le.wlen(1, mcur, n, nz), 0.0);
                                    let nwi = box_slice(heap, le.wilen(1, mcur, n, nz), 0);
                                    let nfi = box_slice(heap, le.filen(1, mcur, nz), 0);
                                    let nff = box_slice(heap, le.fflen(1, mcur, nz), 0.0);
                                    var code = 0;
                                    let usewarm = warm_on && have && !retry;
                                    retry = false;
                                    borrow pw as &p1 in {
                                        borrow pwi as &p2 in {
                                            borrow mut nw as &!q1 in {
                                                borrow mut nwi as &!q2 in {
                                                    borrow mut nfi as &!q3 in {
                                                        borrow mut nff as &!q4 in {
                                                            code = lp_round(ints2, fl2, xv, fv, stv, usewarm, contents(p1), contents(p2), rmv, contents(q1), contents(q2), contents(q3), contents(q4));
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    unbox_slice(heap, nff);
                                    unbox_slice(heap, nfi);
                                    stats[79] = stats[79] + stv[0];
                                    if usewarm {
                                        stats[80] = stats[80] + 1;
                                    }
                                    if check && usewarm && code == sx.s_optimal() {
                                        // the same model from the slack basis: the value must agree
                                        let cw = box_slice(heap, le.wlen(1, mcur, n, nz), 0.0);
                                        let cwi = box_slice(heap, le.wilen(1, mcur, n, nz), 0);
                                        let cfi = box_slice(heap, le.filen(1, mcur, nz), 0);
                                        let cff = box_slice(heap, le.fflen(1, mcur, nz), 0.0);
                                        var cc = 0;
                                        let cold_iters = stv[0];
                                        borrow mut cw as &!c1 in {
                                            borrow mut cwi as &!c2 in {
                                                borrow mut cfi as &!c3 in {
                                                    borrow mut cff as &!c4 in {
                                                        cc = lp_round(ints2, fl2, xcv, fv, stv, false, sfv, siv, siv, contents(c1), contents(c2), contents(c3), contents(c4));
                                                    }
                                                }
                                            }
                                        }
                                        unbox_slice(heap, cff);
                                        unbox_slice(heap, cfi);
                                        unbox_slice(heap, cwi);
                                        unbox_slice(heap, cw);
                                        stats[82] = stats[82] + stv[0];
                                        stv[0] = cold_iters;
                                        if cc != sx.s_optimal() || mag(xcv[n] - xv[n]) > 1e-7 * (1.0 + mag(xv[n])) {
                                            stats[81] = stats[81] + 1;
                                        }
                                    }
                                    unbox_slice(heap, pwi);
                                    unbox_slice(heap, pw);
                                    pw = nw;
                                    pwi = nwi;
                                    okc = code == sx.s_optimal();
                                    have = okc;
                                    if okc {
                                        borrow pwi as &pb in {
                                            basic_flags(contents(pb), n, mcur, bsv);
                                        }
                                        cm.age_cuts(ints2, fl2, xv, m0, mcur, agv);
                                    }
                                    if !okc {
                                        go = false;
                                    } else if fin {
                                        go = false;
                                    } else {
                                        if round > 0 && fv[1] <= last + 1e-9 * (1.0 + mag(last)) {
                                            stall = stall + 1;
                                        } else {
                                            stall = 0;
                                        }
                                        last = fv[1];
                                        let np = cm.separate(ints2, fl2, siv, sfv, xv, n, nnzcap, mcap, round * 137);
                                        found = found + np;
                                        var taken = 0;
                                        var pick = cm.best_cut(siv, sfv, n, nnzcap, mcap, np, taken);
                                        while pick >= 0 && taken < 300 {
                                            let ok = cm.append(ints2, fl2, siv, sfv, n, nnzcap, mcap, pick);
                                            if ok == 1 {
                                                cm.note_taken(siv, n, nnzcap, taken, pick);
                                                taken = taken + 1;
                                            }
                                            pick = cm.best_cut(siv, sfv, n, nnzcap, mcap, np, taken);
                                        }
                                        if taken > 0 {
                                            // the cuts that have been slack for `agelim` rounds leave, with their basic logicals (design.md 22.5)
                                            var lim = agelim;
                                            if ints2[l.h_ncons()] - m0 <= capf * m0 {
                                                lim = 1000000;
                                            }
                                            let rem = cm.drop_aged(ints2, fl2, m0, mcur, agv, bsv, lim, rmv);
                                            stats[84] = stats[84] + rem;
                                        }
                                        if taken == 0 {
                                            if usewarm {
                                                // no cut at this vertex of the optimal face: the same model from the slack basis may give another vertex, and cuts there (design.md 22.3)
                                                retry = true;
                                                stats[83] = stats[83] + 1;
                                            } else {
                                                go = false;
                                            }
                                        } else if round + 1 >= 300 || stall >= stalllim {
                                            // the last cuts need one more LP, for the point the purge reads
                                            fin = true;
                                        }
                                    }
                                }
                                round = round + 1;
                            }
                            // the point of the last LP with every cut: drop the cuts that are not tight there
                            if okc {
                                kept = cm.purge(ints2, fl2, xv, m0);
                            }
                            stats[76] = round;
                            stats[77] = found;
                            stats[78] = kept;
                            }
                            }
                            }
                        }
                    }
                }
            }
        }
    }
    unbox_slice(heap, pwi);
    unbox_slice(heap, pw);
    unbox_slice(heap, srm);
    unbox_slice(heap, sbs);
    unbox_slice(heap, sag);
    unbox_slice(heap, sst);
    unbox_slice(heap, sfr);
    unbox_slice(heap, xc);
    unbox_slice(heap, xs);
    unbox_slice(heap, sf);
    unbox_slice(heap, si);
    return kept;
}

// Solves the MIP of the checked model. With the implied cuts of docs/design.md 19.8 (unless experiment bit 8 is set) the search runs on a copy of the model with the cut rows appended;
// stats[1] still reports the model's own rows and stats[9] the number of cuts.
pub fn search[&h, &a, &b, &c, &d, &e, &f](heap: &!h Heap, ints: &a [int], fl: &b [float], x: &!c [float], stats: &!d [int], fres: &!e [float], opts: &f [int]) -> [heap] int {
    let n = ints[l.h_nvars()];
    let m = ints[l.h_ncons()];
    var code = 0;
    var cuts = 0;
    let implied = opts[4] / 8 % 2 == 0;
    let mir = opts[4] / 64 % 2 == 0;
    stats[76] = 0;
    stats[77] = 0;
    stats[78] = 0;
    stats[79] = 0;
    stats[80] = 0;
    stats[81] = 0;
    stats[82] = 0;
    stats[83] = 0;
    stats[84] = 0;
    stats[70] = opts[4] / 128 % 2;
    if (!implied && !mir) || opts[1] < 1 || m < 2 {
        code = search_in(heap, ints, fl, x, stats, fres, opts, m, false, false);
    } else {
        let i2 = box_slice(heap, l.ints_len(), 0);
        let f2 = box_slice(heap, l.fl_len(), 0.0);
        let si = box_slice(heap, 4 * n + 8, 0);
        let sf = box_slice(heap, 4 * n + 8, 0.0);
        borrow mut i2 as &!b1 in {
            borrow mut f2 as &!b2 in {
                let iv = contents(b1);
                let fv = contents(b2);
                var q = 0;
                while q < l.ints_len() {
                    iv[q] = ints[q];
                    q = q + 1;
                }
                q = 0;
                while q < l.fl_len() {
                    fv[q] = fl[q];
                    q = q + 1;
                }
                if implied {
                    borrow mut si as &!b3 in {
                        borrow mut sf as &!b4 in {
                            cuts = cu.generate(ints, fl, iv, fv, contents(b3), contents(b4));
                        }
                    }
                }
                // The MIR cuts are only worth their rounds when the search does not settle the model by itself: the first 300 nodes run without them (a model that one of
                // the roundings and the implied cuts close, like the ample EV models, never pays for them), and then, if the search is not over, the rounds run, and the search
                // starts again from the root on the model with the cuts, keeping the incumbent (docs/design.md 22.1).
                let eager = opts[4] / 256 % 2 == 1;
                if mir && eager {
                    // experiment bit 256: the rounds before the search, whatever it would have done (the gates use it, so that small models, which the search settles in fewer
                    // than 300 nodes, exercise the cuts)
                    mir_rounds(heap, iv, fv, opts, stats);
                }
                let pend = mir && !eager && opts[0] < 0 && opts[1] > 300;
                if pend {
                    // the first run needs room for 301 nodes only
                    let o1 = box_slice(heap, 8, 0);
                    borrow mut o1 as &!o1w in {
                        let ov1 = contents(o1w);
                        var u1 = 0;
                        while u1 < 6 {
                            ov1[u1] = opts[u1];
                            u1 = u1 + 1;
                        }
                        ov1[1] = 301;
                        code = search_in(heap, iv, fv, x, stats, fres, ov1, m, false, true);
                    }
                    unbox_slice(heap, o1);
                } else {
                    code = search_in(heap, iv, fv, x, stats, fres, opts, m, false, false);
                }
                if code == r_paused() {
                    let n1 = stats[3];
                    let i1 = stats[0];
                    let b1 = stats[5];
                    let had = stats[6] > 0;
                    mir_rounds(heap, iv, fv, opts, stats);
                    let o2 = box_slice(heap, 8, 0);
                    borrow mut o2 as &!o2w in {
                        let ov = contents(o2w);
                        var u = 0;
                        while u < 6 {
                            ov[u] = opts[u];
                            u = u + 1;
                        }
                        ov[1] = opts[1] - n1;
                        code = search_in(heap, iv, fv, x, stats, fres, ov, m, had, false);
                    }
                    unbox_slice(heap, o2);
                    stats[3] = stats[3] + n1;
                    stats[0] = stats[0] + i1;
                    stats[5] = stats[5] + b1;
                }
            }
        }
        unbox_slice(heap, sf);
        unbox_slice(heap, si);
        unbox_slice(heap, f2);
        unbox_slice(heap, i2);
    }
    stats[9] = cuts;
    return code;
}
