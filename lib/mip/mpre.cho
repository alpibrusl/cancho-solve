edition 7;

module solve.mpre;

// The presolve of the MIP search (docs/design.md 22.12). Pure functions over the checked model: `reduce` finds, by the rules of 21.3 with the integer columns' bounds rounded inward, the bounds the
// search may start from and the rows it may drop; `compact` writes the model without the dropped rows. No column is removed: a column the rules fix keeps its place with lo == hi.
//   rows        redundant (activity bounds under the current column bounds satisfy it), singleton (one live column: it becomes a bound), empty (checked); the fixed columns of a row are
//               moved to its sides in the analysis only, the model is not changed
//   columns     dual fixing: a column whose cost and rows all want it at one bound is fixed there, whether or not it is integer
// Sweeps over the rows and then the columns until nothing changes, at most 20.

import solve.layout as l;

fn mag(x: float) -> [] float {
    if x < 0.0 {
        return -x;
    }
    return x;
}

fn tol(b: float) -> [] float {
    return 1e-9 * (1.0 + mag(b));
}

fn floor_of(v: float) -> [] float {
    if v > 1e15 || v < -1e15 {
        return v;
    }
    let t = float_of(truncate(v));
    if t > v {
        return t - 1.0;
    }
    return t;
}

// The bounds in bnd[0..n) (lower) and bnd[n..2n) (upper) must hold the model's bounds on entry (heur.col_bounds); ik[j] is 1 for an integer column. keep[0..m) becomes 1 for a row to keep and 0
// for one to drop; scr needs 2n ints and cf n floats of scratch. cnt[0] is the rows dropped, cnt[1] the columns the rules fixed, cnt[2] the bounds a singleton row tightened.
// Returns 0, or 1 when a rule proves the model infeasible.
pub fn reduce[&a, &b, &c, &d, &e, &f, &g, &h](ints: &a [int], fl: &b [float], ik: &c [int], bnd: &!d [float], keep: &!e [int], scr: &!f [int], cf: &!g [float], cnt: &!h [int]) -> [] int {
    let n = ints[l.h_nvars()];
    let m = ints[l.h_ncons()];
    var j = 0;
    while j < n {
        cf[j] = 0.0;
        j = j + 1;
    }
    if ints[l.h_sense()] != 0 {
        var sg = 1.0;
        if ints[l.h_sense()] == 2 {
            sg = -1.0;
        }
        var t0 = 0;
        while t0 < ints[l.h_obj_nnz()] {
            let jo = ints[l.obj_col(t0)];
            cf[jo] = cf[jo] + sg * fl[l.obj_coef(t0)];
            t0 = t0 + 1;
        }
    }
    var fixed0 = 0;
    j = 0;
    while j < n {
        if bnd[j] == bnd[n + j] {
            fixed0 = fixed0 + 1;
        }
        j = j + 1;
    }
    var r = 0;
    while r < m {
        keep[r] = 1;
        r = r + 1;
    }
    cnt[0] = 0;
    cnt[1] = 0;
    cnt[2] = 0;
    var infeasible = false;
    var changed = true;
    var sweep = 0;
    while changed && sweep < 20 && !infeasible {
        changed = false;
        sweep = sweep + 1;
        r = 0;
        while r < m && !infeasible {
            if keep[r] == 1 {
                let s = ints[l.row_sense(r)];
                let rhs = fl[l.row_rhs(r)];
                var rlo = -1e300;
                var rhi = 1e300;
                if s != 0 {
                    rlo = rhs;
                }
                if s != 1 {
                    rhi = rhs;
                }
                var fx = 0.0;
                var amin = 0.0;
                var amax = 0.0;
                var live = 0;
                var jl = 0 - 1;
                var al = 0.0;
                var t = ints[l.row_start(r)];
                while t < ints[l.row_start(r + 1)] {
                    let a = fl[l.term_coef(t)];
                    let jc = ints[l.term_col(t)];
                    if mag(a) >= 1e-12 {
                        let lo = bnd[jc];
                        let hi = bnd[n + jc];
                        if lo == hi {
                            fx = fx + a * lo;
                        } else {
                            live = live + 1;
                            jl = jc;
                            al = a;
                            if a > 0.0 {
                                amin = amin + a * lo;
                                amax = amax + a * hi;
                            } else {
                                amin = amin + a * hi;
                                amax = amax + a * lo;
                            }
                        }
                    }
                    t = t + 1;
                }
                if rlo > -1e299 {
                    rlo = rlo - fx;
                }
                if rhi < 1e299 {
                    rhi = rhi - fx;
                }
                if live == 0 {
                    if rlo > tol(rlo) && rlo > -1e299 || rhi < 0.0 - tol(rhi) && rhi < 1e299 {
                        infeasible = true;
                    }
                    keep[r] = 0;
                    changed = true;
                } else if amin >= rlo - tol(rlo) && amax <= rhi + tol(rhi) {
                    keep[r] = 0;
                    changed = true;
                } else if amin > rhi + tol(rhi) || amax < rlo - tol(rlo) {
                    infeasible = true;
                } else if live == 1 && mag(al) > 1e-9 {
                    var l2 = -1e300;
                    var h2 = 1e300;
                    if al > 0.0 {
                        if rlo > -1e299 {
                            l2 = rlo / al;
                        }
                        if rhi < 1e299 {
                            h2 = rhi / al;
                        }
                    } else {
                        if rhi < 1e299 {
                            l2 = rhi / al;
                        }
                        if rlo > -1e299 {
                            h2 = rlo / al;
                        }
                    }
                    if ik[jl] == 1 {
                        if l2 > -1e299 {
                            l2 = 0.0 - floor_of(0.0 - (l2 - 1e-9));
                        }
                        if h2 < 1e299 {
                            h2 = floor_of(h2 + 1e-9);
                        }
                    }
                    var nl = bnd[jl];
                    var nh = bnd[n + jl];
                    var ch = false;
                    if l2 > nl {
                        nl = l2;
                        ch = true;
                    }
                    if h2 < nh {
                        nh = h2;
                        ch = true;
                    }
                    if nl > nh + tol(nh) {
                        infeasible = true;
                    }
                    if nl > nh {
                        nl = nh;
                    }
                    bnd[jl] = nl;
                    bnd[n + jl] = nh;
                    keep[r] = 0;
                    changed = true;
                    if ch {
                        cnt[2] = cnt[2] + 1;
                    }
                }
            }
            r = r + 1;
        }
        // dual fixing: scr[j] 1 when lowering column j can hurt a live row, scr[n + j] when raising it can
        j = 0;
        while j < 2 * n {
            scr[j] = 0;
            j = j + 1;
        }
        r = 0;
        while r < m && !infeasible {
            if keep[r] == 1 {
                let s = ints[l.row_sense(r)];
                var t = ints[l.row_start(r)];
                while t < ints[l.row_start(r + 1)] {
                    let a = fl[l.term_coef(t)];
                    let jc = ints[l.term_col(t)];
                    if mag(a) >= 1e-12 && bnd[jc] < bnd[n + jc] {
                        let nolo = s == 0;
                        let nohi = s == 1;
                        if !(a > 0.0 && nolo || a < 0.0 && nohi) {
                            scr[jc] = 1;
                        }
                        if !(a > 0.0 && nohi || a < 0.0 && nolo) {
                            scr[n + jc] = 1;
                        }
                    }
                    t = t + 1;
                }
            }
            r = r + 1;
        }
        j = 0;
        while j < n && !infeasible {
            if bnd[j] < bnd[n + j] {
                if cf[j] >= 0.0 && scr[j] == 0 {
                    bnd[n + j] = bnd[j];
                    changed = true;
                } else if cf[j] <= 0.0 && scr[n + j] == 0 {
                    bnd[j] = bnd[n + j];
                    changed = true;
                }
            }
            j = j + 1;
        }
    }
    var fixed1 = 0;
    j = 0;
    while j < n {
        if bnd[j] == bnd[n + j] {
            fixed1 = fixed1 + 1;
        }
        j = j + 1;
    }
    var dropped = 0;
    r = 0;
    while r < m {
        if keep[r] == 0 {
            dropped = dropped + 1;
        }
        r = r + 1;
    }
    cnt[0] = dropped;
    cnt[1] = fixed1 - fixed0;
    if infeasible {
        return 1;
    }
    return 0;
}

// Removes the rows with keep[r] == 0 from the model, in place (a copy of the checked model), and substitutes the fixed columns (bnd[j] == bnd[n + j]) out of the rows that stay: their terms
// leave the row and move to its right side. The cut generator reads a covering row only when every column in it is linked to a variable upper bound, so a fixed column left in a row would
// make it useless (design.md 22.12). A row left with no term is dropped when it holds, and the model is refused (-1) when it does not. Returns the rows removed, or -1.
pub fn compact[&a, &b, &c, &d](ints: &!a [int], fl: &!b [float], keep: &c [int], bnd: &d [float]) -> [] int {
    let m = ints[l.h_ncons()];
    let n = ints[l.h_nvars()];
    var w = 0;
    var nnz = 0;
    var r = 0;
    var s0 = 0;
    while r < m {
        // the original start of row r + 1 is read before row_start(w + 1) may be overwritten, and carried to the next row
        let e0 = ints[l.row_start(r + 1)];
        if keep[r] == 1 {
            let rhs = fl[l.row_rhs(r)];
            let sense = ints[l.row_sense(r)];
            var fx = 0.0;
            var cnt = 0;
            var t = s0;
            while t < e0 {
                let jc = ints[l.term_col(t)];
                let a = fl[l.term_coef(t)];
                if bnd[jc] == bnd[n + jc] {
                    fx = fx + a * bnd[jc];
                } else {
                    ints[l.term_col(nnz + cnt)] = jc;
                    fl[l.term_coef(nnz + cnt)] = a;
                    cnt = cnt + 1;
                }
                t = t + 1;
            }
            let nr = rhs - fx;
            if cnt == 0 {
                if sense == 0 && nr < 0.0 - tol(nr) || sense == 1 && nr > tol(nr) || sense == 2 && mag(nr) > tol(nr) {
                    return 0 - 1;
                }
            } else {
                ints[l.row_sense(w)] = sense;
                fl[l.row_rhs(w)] = nr;
                nnz = nnz + cnt;
                ints[l.row_start(w + 1)] = nnz;
                w = w + 1;
            }
        }
        s0 = e0;
        r = r + 1;
    }
    ints[l.row_start(0)] = 0;
    ints[l.h_ncons()] = w;
    ints[l.h_nnz()] = nnz;
    return m - w;
}
