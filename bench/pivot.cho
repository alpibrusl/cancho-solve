edition 7;

import std.bytes;
import std.io;

// The pivot's row update, alone: row_i -= f * row_r for every row i != r, repeated. Three ways of writing the inner loop.

// A: what solve uses today -- one flat slice, indices ib + j and rb + j (checked adds, loaded bounds).
fn sweep_a[&a](w: &!a [float], m: int, big: int, r: int, q: int, rounds: int) -> [] int {
    var n = 0;
    while n < rounds {
        let rb = r * big;
        var i = 0;
        while i < m {
            if i != r {
                let f = w[i * big + q];
                if f != 0.0 {
                    let ib = i * big;
                    var j = 0;
                    while j < big {
                        w[ib + j] = w[ib + j] - f * w[rb + j];
                        j = j + 1;
                    }
                }
            }
            i = i + 1;
        }
        n = n + 1;
    }
    return 0;
}

// B: the same loop on two row slices taken once for each row; the loop's own condition proves both bounds.
fn sweep_b[&a](w: &!a [float], m: int, big: int, r: int, q: int, rounds: int) -> [] int {
    var n = 0;
    while n < rounds {
        let src = w[r * big..r * big + big];
        var i = 0;
        while i < m {
            if i != r {
                let f = w[i * big + q];
                if f != 0.0 {
                    let dst = w[i * big..i * big + big];
                    var j = 0;
                    while j < len(dst) && j < len(src) {
                        dst[j] = dst[j] - f * src[j];
                        j = j + 1;
                    }
                }
            }
            i = i + 1;
        }
        n = n + 1;
    }
    return 0;
}

// C: A with the index sums spelled wrapping_add (no overflow trap); the bounds checks stay, now on loaded-looking indices.
fn sweep_c[&a](w: &!a [float], m: int, big: int, r: int, q: int, rounds: int) -> [] int {
    var n = 0;
    while n < rounds {
        let rb = r * big;
        var i = 0;
        while i < m {
            if i != r {
                let f = w[i * big + q];
                if f != 0.0 {
                    let ib = i * big;
                    var j = 0;
                    while j < big {
                        w[wrapping_add(ib, j)] = w[wrapping_add(ib, j)] - f * w[wrapping_add(rb, j)];
                        j = j + 1;
                    }
                }
            }
            i = i + 1;
        }
        n = n + 1;
    }
    return 0;
}

fn run[&h, &i, &g](heap: &!h Heap, io: &!i Io, which: &g [byte]) -> [heap, io_write] int {
    let m = 400;
    let big = 1200;
    let cells = m * big;
    let store = box_slice(heap, cells, 1.0);
    borrow mut store as &!sw in {
        let w = contents(sw);
        var k = 0;
        while k < cells {
            w[k] = 1.0 + float_of(k % 7) * 0.25;
            k = k + 1;
        }
        // the multipliers: column 5 of every row, tiny so nothing grows
        var i = 0;
        while i < m {
            w[i * big + 5] = 1e-9;
            i = i + 1;
        }
        if bytes.equal(which, "a") {
            sweep_a(w, m, big, 3, 5, 100);
        } else if bytes.equal(which, "b") {
            sweep_b(w, m, big, 3, 5, 100);
        } else {
            sweep_c(w, m, big, 3, 5, 100);
        }
        var sum = 0.0;
        k = 0;
        while k < cells {
            sum = sum + w[k];
            k = k + 1;
        }
        io.print_int(io, truncate(sum));
        io.newline(io);
    }
    unbox_slice(heap, store);
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(fs);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    borrow args as &g in {
        borrow mut heap as &!h in {
            borrow mut io as &!i in {
                run(h, i, arg(g, 1));
            }
        }
    }
    release(args);
    release(heap);
    release(io);
    return 0;
}
