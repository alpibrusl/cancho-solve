// A non-negative decimal number of at most 9 digits, or -1.
fn number[&a](text: &a [byte]) -> [] int {
    if len(text) == 0 || len(text) > 9 {
        return 0 - 1;
    }
    var v = 0;
    var k = 0;
    while k < len(text) {
        let c = int_of(text[k]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        v = v * 10 + (c - '0');
        k = k + 1;
    }
    return v;
}

// The bits of a list `name[=value],name[=value],...`, or -1: an unknown name, an empty one, a name twice, a flag with a value, a field without one or out of its range.
pub fn parse[&a](text: &a [byte]) -> [] int {
    if len(text) == 0 {
        return 0 - 1;
    }
    var bits = 0;
    var seen = 0;
    var from = 0;
    var at = 0;
    while at <= len(text) {
        if at == len(text) || int_of(text[at]) == ',' {
            let tok = text[from..at];
            var eq = 0 - 1;
            var q = 0;
            while q < len(tok) {
                if int_of(tok[q]) == '=' && eq < 0 {
                    eq = q;
                }
                q = q + 1;
            }
            var nm = tok;
            if eq >= 0 {
                nm = tok[0..eq];
            }
            var which = 0 - 1;
            var k = 0;
            while k < count() {
                if bytes.equal(nm, name_of(k)) {
                    which = k;
                }
                k = k + 1;
            }
            if which < 0 || (seen / pow2(which)) % 2 == 1 {
                return 0 - 1;
            }
            seen = seen + pow2(which);
            if max_of(which) == 0 {
                if eq >= 0 {
                    return 0 - 1;
                }
                bits = bits + bit_of(which);
            } else {
                if eq < 0 {
                    return 0 - 1;
                }
                let v = number(tok[eq + 1..len(tok)]);
                if v < min_of(which) || v > max_of(which) {
                    return 0 - 1;
                }
                bits = bits + bit_of(which) * (v + offset_of(which));
            }
            from = at + 1;
        }
        at = at + 1;
    }
    return bits;
}

fn pow2(k: int) -> [] int {
    return 1 << k;
}

// `"experiments":[{"name","bit","min","max","offset"},...]` for `solve introspect`.
pub fn put_table[&h](heap: &!h Heap, w: json.Writer) -> [heap] json.Writer {
    var out = json.put_key(heap, w, "experiments");
    out = json.begin_array(heap, out);
    var k = 0;
    while k < count() {
        out = json.begin_object(heap, out);
        out = json.put_key(heap, out, "name");
        out = json.put_string(heap, out, name_of(k));
        out = json.put_key(heap, out, "bit");
        out = json.put_int(heap, out, bit_of(k));
        out = json.put_key(heap, out, "min");
        out = json.put_int(heap, out, min_of(k));
        out = json.put_key(heap, out, "max");
        out = json.put_int(heap, out, max_of(k));
        out = json.put_key(heap, out, "offset");
        out = json.put_int(heap, out, offset_of(k));
        out = json.end_object(heap, out);
        k = k + 1;
    }
    return json.end_array(heap, out);
}
