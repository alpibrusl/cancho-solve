edition 7;

module solve.exper;

// The experiment bits of `solve run --experiment N`, by name (docs/design.md 22.18): `--exp profile,restarts=3` is `--experiment 134217856` (128 + 134217728 * 4). One table, read by the parser
// and by `solve introspect`; `scripts/check_exp.py` holds its own copy of the table and compares. A flag is one bit (max 0); a field is `bit * (value + offset)` for a value from min to max.
// What each one does is written where it is read (`lib/mip/mip.cho`, `docs/design.md` 19 and 22). An experiment that is built and then reverted leaves no name here.

import std.bytes;
import std.json;

pub fn count() -> [] int {
    return 20;
}

