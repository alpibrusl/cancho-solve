edition 7;

// `solve` — linear and mixed-integer models as a command line (docs/design.md).
//
//     solve check           read a model on standard input and check it
//     solve expand          read a model on standard input and print the expanded flat model (docs/design.md section 12)
//     solve run [--relax] [--iteration-limit N] [--method dense|sparse|auto]   solve the linear program (docs/design.md sections 14 and 18.3)
//     solve introspect      the commands, exit codes and rule tags as JSON
//     solve skill           how to write a model, as text
//
// Standard output, for `check`, one JSON object:
//
//     {"status":"ok","class":"MIP","variables":2,"integer":1,"constraints":1,"nonzeros":2,"objective":"minimize"}
//
// Exit status 0 when the model is accepted, 2 on a refusal. A refusal prints nothing on standard output and, on standard error, one JSON object
// `{"error":"solve.<rule>","message":"...","repair":"...","at":{"line":L,"col":C}}`; the rule tags are listed in docs/design.md section 8.
// The binary reads standard input and writes standard output and error; it reads no file and has no network.

import solve.emit;
import solve.layout;
import solve.lex;
import solve.revised;
import solve.simplex;
import solve.stmt;
import std.buffer;
import std.bytes;
import std.io;
import std.json;

fn slurp[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read] buffer.Buffer {
    var out = buffer.empty(heap, 4096);
    var c = getchar(io);
    while c >= 0 {
        out = buffer.push(heap, out, byte_of(c));
        c = getchar(io);
    }
    return out;
}

// mode 0 `check`, 1 `expand`, 2 `run` (with `relax` and `limit`).
fn run_model[&h, &i](heap: &!h Heap, io: &!i Io, mode: int, relax: bool, limit: int, method: int) -> [heap, io_read, io_write, err_write] int {
    let text = slurp(heap, io);
    let ints = box_slice(heap, layout.ints_len(), 0);
    let fl = box_slice(heap, layout.fl_len(), 0.0);
    var status = 0;
    borrow text as &tb in {
        borrow mut ints as &!iw in {
            borrow mut fl as &!fw in {
                let tx = buffer.bytes(tb);
                let n = contents(iw);
                let f = contents(fw);
                let rule = stmt.check(tx, n, f);
                if rule != 0 {
                    status = emit.refuse(heap, io, lex.rule_name(rule), lex.rule_message(rule), lex.rule_repair(rule), tx, n[layout.h_at()]);
                } else if mode == 1 {
                    status = emit.expand(heap, io, tx, n, f);
                } else if mode == 2 {
                    if n[layout.h_nints()] > 0 && !relax {
                        status = emit.refuse(heap, io, "solve.not-built", "integer and boolean variables need the MIP solver, which is not built yet (docs/design.md section 9, S3)", "pass --relax to solve the relaxation, or declare the variables real", tx, 0 - 1);
                    } else {
                        let xs = box_slice(heap, n[layout.h_nvars()] + 1, 0.0);
                        let st = box_slice(heap, 4, 0);
                        borrow mut xs as &!xw in {
                            borrow mut st as &!sw in {
                                let xv = contents(xw);
                                let sv = contents(sw);
                                var code = 0;
                                if method == 1 {
                                    code = revised.solve(heap, n, f, xv, sv, limit);
                                } else {
                                    code = simplex.solve(heap, n, f, xv, sv, limit);
                                }
                                if code == 4 {
                                    status = emit.refuse(heap, io, "solve.numerical", "the sparse solver met a basis it could not factorise or a dual infeasibility it could not repair", "run with --method dense", tx, 0 - 1);
                                } else if code == simplex.s_too_large() {
                                    status = emit.refuse(heap, io, "solve.too-large", "the dense tableau would exceed 32,000,000 cells", "reduce the model; the dense simplex is a first solver (docs/design.md section 14)", tx, 0 - 1);
                                } else {
                                    status = emit.run_report(heap, io, tx, n, f, xv, sv, code, relax);
                                }
                            }
                        }
                        unbox_slice(heap, st);
                        unbox_slice(heap, xs);
                    }
                } else {
                    status = emit.report(heap, io, n);
                }
            }
        }
    }
    unbox_slice(heap, fl);
    unbox_slice(heap, ints);
    buffer.drop(heap, text);
    return status;
}

// A non-negative decimal number, or -1.
fn parse_count[&a](text: &a [byte]) -> [] int {
    if len(text) == 0 || len(text) > 12 {
        return 0 - 1;
    }
    var v = 0;
    var k = 0;
    while k < len(text) {
        let c = int_of(text[k]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        v = v * 10 + (c - '0');
        k = k + 1;
    }
    return v;
}

// `--method`: 0 dense, 1 sparse, 2 auto (decided from the model's size and density by `auto_method`, docs/design.md 18.4), or -1.
fn method_code[&a](text: &a [byte]) -> [] int {
    if bytes.equal(text, "dense") {
        return 0;
    }
    if bytes.equal(text, "sparse") {
        return 1;
    }
    if bytes.equal(text, "auto") {
        return 2;
    }
    return 0 - 1;
}

fn usage[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, err_write] int {
    return emit.refuse(heap, io, "solve.usage", "usage: solve check | expand | run [--relax] [--iteration-limit N] [--method dense|sparse|auto] | introspect | skill", "pass one verb; check and expand read the model on standard input", "", 0 - 1);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(fs);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    var status = 2;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &g in {
                if arg_count(g) < 2 {
                    status = usage(h, i);
                } else if bytes.equal(arg(g, 1), "check") {
                    status = run_model(h, i, 0, false, 0 - 1, 0);
                } else if bytes.equal(arg(g, 1), "expand") {
                    status = run_model(h, i, 1, false, 0 - 1, 0);
                } else if bytes.equal(arg(g, 1), "run") {
                    var relax = false;
                    var limit = 0 - 1;
                    var good = true;
                    var method = 0;
                    var a = 2;
                    while a < arg_count(g) && good {
                        if bytes.equal(arg(g, a), "--relax") {
                            relax = true;
                        } else if bytes.equal(arg(g, a), "--iteration-limit") && a + 1 < arg_count(g) && parse_count(arg(g, a + 1)) >= 0 {
                            limit = parse_count(arg(g, a + 1));
                            a = a + 1;
                        } else if bytes.equal(arg(g, a), "--method") && a + 1 < arg_count(g) && method_code(arg(g, a + 1)) >= 0 {
                            method = method_code(arg(g, a + 1));
                            a = a + 1;
                        } else {
                            good = false;
                        }
                        a = a + 1;
                    }
                    if good {
                        status = run_model(h, i, 2, relax, limit, method);
                    } else {
                        status = usage(h, i);
                    }
                } else if bytes.equal(arg(g, 1), "introspect") {
                    status = emit.introspect(h, i);
                } else if bytes.equal(arg(g, 1), "skill") {
                    status = emit.skill(i);
                } else {
                    status = usage(h, i);
                }
            }
        }
    }
    release(args);
    release(heap);
    release(io);
    return status;
}
