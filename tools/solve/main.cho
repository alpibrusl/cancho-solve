edition 7;

// `solve` — linear and mixed-integer models as a command line (docs/design.md).
//
//     solve check           read a model on standard input and check it
//     solve expand          read a model on standard input and print the expanded flat model (docs/design.md section 12)
//     solve run [--relax] [--iteration-limit N] [--method dense|sparse|auto] [--node-limit N] [--node-select depth|best|hybrid] [--branching fractional|pseudo]   solve the model: an LP (sections 14, 18.3) or a MIP (section 19)
//     solve verify [--tolerance T]   read a model, a line `---` and a claimed solution on standard input; re-check feasibility and the objective (docs/design.md section 20)
//     solve introspect      the commands, exit codes and rule tags as JSON
//     solve skill           how to write a model, as text
//
// Standard output, for `check`, one JSON object:
//
//     {"status":"ok","class":"MIP","variables":2,"integer":1,"constraints":1,"nonzeros":2,"objective":"minimize"}
//
// Exit status 0 when the model is accepted, 2 on a refusal. A refusal prints nothing on standard output and, on standard error, one JSON object
// `{"error":"solve.<rule>","message":"...","repair":"...","at":{"line":L,"col":C}}`; the rule tags are listed in docs/design.md section 8.
// The binary reads standard input and writes standard output and error; it reads no file and has no network.

import solve.emit;
import solve.layout;
import solve.lex;
import solve.mip;
import solve.revised;
import solve.simplex;
import solve.stmt;
import solve.verify;
import std.buffer;
import std.bytes;
import std.io;
import std.json;

fn slurp[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read] buffer.Buffer {
    var out = buffer.empty(heap, 4096);
    var c = getchar(io);
    while c >= 0 {
        out = buffer.push(heap, out, byte_of(c));
        c = getchar(io);
    }
    return out;
}

// A model with integer variables: branch and bound (docs/design.md section 19). Options: the iteration budget (-1 none), the node limit, node selection, branching, experiment bits.
fn run_mip[&h, &i, &t, &a, &b](heap: &!h Heap, io: &!i Io, tx: &t [byte], n: &a [int], f: &b [float], limit: int, onodes: int, osel: int, obr: int, oexp: int, eng: int) -> [heap, io_write, err_write] int {
    if onodes > mip.max_node_limit() {
        return emit.refuse(heap, io, "solve.too-large", "the node limit is above 2,000,000", "pass a smaller --node-limit", tx, 0 - 1);
    }
    let opts = box_slice(heap, 6, 0);
    let xs = box_slice(heap, n[layout.h_nvars()] + 1, 0.0);
    let st = box_slice(heap, 84, 0);
    let fr = box_slice(heap, 2, 0.0);
    var status = 0;
    borrow mut opts as &!ow in {
        let ov = contents(ow);
        ov[0] = limit;
        ov[1] = onodes;
        ov[2] = osel;
        ov[3] = obr;
        ov[4] = oexp;
        ov[5] = eng;
        borrow mut xs as &!xw in {
            borrow mut st as &!sw in {
                borrow mut fr as &!fw in {
                    let xv = contents(xw);
                    let sv = contents(sw);
                    let fv = contents(fw);
                    sv[8] = eng;
                    let code = mip.search(heap, n, f, xv, sv, fv, ov);
                    if code == mip.r_too_large() {
                        status = emit.refuse(heap, io, "solve.too-large", "the dense tableau would exceed 32,000,000 cells", "reduce the model; the dense simplex is a first solver (docs/design.md section 14)", tx, 0 - 1);
                    } else if code == mip.r_numerical() {
                        status = emit.refuse(heap, io, "solve.numerical", "the sparse solver met a basis it could not factorise, a dual infeasibility it could not repair or a factorisation that did not fit", "run with --method dense", tx, 0 - 1);
                    } else {
                        status = emit.mip_report(heap, io, tx, n, f, xv, sv, fv, code);
                    }
                }
            }
        }
    }
    unbox_slice(heap, fr);
    unbox_slice(heap, st);
    unbox_slice(heap, xs);
    unbox_slice(heap, opts);
    return status;
}

// mode 0 `check`, 1 `expand`, 2 `run` (with `relax` and `limit`).
fn run_model[&h, &i](heap: &!h Heap, io: &!i Io, mode: int, relax: bool, limit: int, method: int, onodes: int, osel: int, obr: int, oexp: int) -> [heap, io_read, io_write, err_write] int {
    let text = slurp(heap, io);
    let ints = box_slice(heap, layout.ints_len(), 0);
    let fl = box_slice(heap, layout.fl_len(), 0.0);
    var status = 0;
    borrow text as &tb in {
        borrow mut ints as &!iw in {
            borrow mut fl as &!fw in {
                let tx = buffer.bytes(tb);
                let n = contents(iw);
                let f = contents(fw);
                let rule = stmt.check(tx, n, f);
                if rule != 0 {
                    status = emit.refuse(heap, io, lex.rule_name(rule), lex.rule_message(rule), lex.rule_repair(rule), tx, n[layout.h_at()]);
                } else if mode == 1 {
                    status = emit.expand(heap, io, tx, n, f);
                } else if mode == 2 {
                    if n[layout.h_nints()] > 0 && !relax {
                        var eng = method;
                        if method == 2 {
                            eng = auto_method(n);
                        }
                        if method == 3 {
                            eng = 1;
                        }
                        status = run_mip(heap, io, tx, n, f, limit, onodes, osel, obr, oexp, eng);
                    } else {
                        let xs = box_slice(heap, n[layout.h_nvars()] + 1, 0.0);
                        let st = box_slice(heap, 6, 0);
                        borrow mut xs as &!xw in {
                            borrow mut st as &!sw in {
                                let xv = contents(xw);
                                let sv = contents(sw);
                                var code = 0;
                                var use = method;
                                if method == 2 {
                                    use = auto_method(n);
                                }
                                if use == 1 {
                                    code = revised.solve(heap, n, f, xv, sv, limit);
                                } else if use == 3 {
                                    code = revised.solve_unreduced(heap, n, f, xv, sv, limit);
                                } else {
                                    code = simplex.solve(heap, n, f, xv, sv, limit);
                                }
                                if code == 4 {
                                    status = emit.refuse(heap, io, "solve.numerical", "the sparse solver met a basis it could not factorise or a dual infeasibility it could not repair", "run with --method dense", tx, 0 - 1);
                                } else if code == simplex.s_too_large() {
                                    status = emit.refuse(heap, io, "solve.too-large", "the dense tableau would exceed 32,000,000 cells, or the sparse solver's factorisation outgrew its pool", "reduce the model; see docs/design.md sections 14 and 18.3.2", tx, 0 - 1);
                                } else {
                                    status = emit.run_report(heap, io, tx, n, f, xv, sv, code, relax);
                                }
                            }
                        }
                        unbox_slice(heap, st);
                        unbox_slice(heap, xs);
                    }
                } else {
                    status = emit.report(heap, io, n);
                }
            }
        }
    }
    unbox_slice(heap, fl);
    unbox_slice(heap, ints);
    buffer.drop(heap, text);
    return status;
}

// `verify` (docs/design.md section 20): standard input is the model, a line holding exactly `---`, then the claimed solution. The model is checked as for every verb; the check
// of the solution is lib/verify/verify.cho, which shares nothing with the search.
fn run_verify[&h, &i](heap: &!h Heap, io: &!i Io, tol: float) -> [heap, io_read, io_write, err_write] int {
    let text = slurp(heap, io);
    let ints = box_slice(heap, layout.ints_len(), 0);
    let fl = box_slice(heap, layout.fl_len(), 0.0);
    var status = 2;
    borrow text as &tb in {
        let tx = buffer.bytes(tb);
        // the first line that is `---` (a trailing carriage return allowed)
        var pos = 0;
        var cut = 0 - 1;
        var after = 0;
        while pos <= len(tx) && cut < 0 {
            var e = pos;
            while e < len(tx) && int_of(tx[e]) != 10 {
                e = e + 1;
            }
            var le = e;
            if le > pos && int_of(tx[le - 1]) == 13 {
                le = le - 1;
            }
            if le - pos == 3 && int_of(tx[pos]) == '-' && int_of(tx[pos + 1]) == '-' && int_of(tx[pos + 2]) == '-' {
                cut = pos;
                after = e + 1;
                if after > len(tx) {
                    after = len(tx);
                }
            }
            pos = e + 1;
        }
        if cut < 0 {
            status = emit.refuse(heap, io, verify.rule_name(5), "no line holding exactly --- separates the model from the claimed solution", verify.rule_repair(5), tx, 0 - 1);
        } else {
            let model = tx[0..cut];
            borrow mut ints as &!iw in {
                borrow mut fl as &!fw in {
                    let n = contents(iw);
                    let f = contents(fw);
                    let rule = stmt.check(model, n, f);
                    if rule != 0 {
                        status = emit.refuse(heap, io, lex.rule_name(rule), lex.rule_message(rule), lex.rule_repair(rule), model, n[layout.h_at()]);
                    } else {
                        status = verify.run(heap, io, model, n, f, tx[after..len(tx)], tol);
                    }
                }
            }
        }
    }
    unbox_slice(heap, fl);
    unbox_slice(heap, ints);
    buffer.drop(heap, text);
    return status;
}

// A non-negative decimal number, or -1.
fn parse_count[&a](text: &a [byte]) -> [] int {
    if len(text) == 0 || len(text) > 12 {
        return 0 - 1;
    }
    var v = 0;
    var k = 0;
    while k < len(text) {
        let c = int_of(text[k]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        v = v * 10 + (c - '0');
        k = k + 1;
    }
    return v;
}

// `auto` (docs/design.md 18.4): the sparse solver when the tableau would not fit, or when the matrix is at most 4% full (measured: the sparse solver is faster below about 5%
// density and slower above it); the dense tableau otherwise.
fn auto_method[&a](ints: &a [int]) -> [] int {
    let m = ints[layout.h_ncons()];
    let n = ints[layout.h_nvars()];
    if m * (n + m) + 6 * (n + m) + m > simplex.max_cells() {
        return 1;
    }
    if 25 * ints[layout.h_nnz()] <= m * n {
        return 1;
    }
    return 0;
}

// `--method`: 0 dense, 1 sparse, 2 auto (decided from the model's size and density by `auto_method`, docs/design.md 18.4), or -1.
fn method_code[&a](text: &a [byte]) -> [] int {
    if bytes.equal(text, "dense") {
        return 0;
    }
    if bytes.equal(text, "sparse") {
        return 1;
    }
    if bytes.equal(text, "auto") {
        return 2;
    }
    // the sparse solver without its presolve (design.md 21.3), for the gates that compare the two
    if bytes.equal(text, "sparse-raw") {
        return 3;
    }
    return 0 - 1;
}

fn usage[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, err_write] int {
    return emit.refuse(heap, io, "solve.usage", "usage: solve check | expand | run [--relax] [--iteration-limit N] [--method dense|sparse|auto] [--node-limit N] [--node-select depth|best|hybrid] [--branching fractional|pseudo] | verify [--tolerance T] | introspect | skill", "pass one verb; check, expand, run and verify read the model on standard input", "", 0 - 1);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(fs);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    var status = 2;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &g in {
                if arg_count(g) < 2 {
                    status = usage(h, i);
                } else if bytes.equal(arg(g, 1), "check") {
                    status = run_model(h, i, 0, false, 0 - 1, 0, 200000, 1, 1, 0);
                } else if bytes.equal(arg(g, 1), "expand") {
                    status = run_model(h, i, 1, false, 0 - 1, 0, 200000, 1, 1, 0);
                } else if bytes.equal(arg(g, 1), "run") {
                    var relax = false;
                    var limit = 0 - 1;
                    var onodes = 200000;
                    var osel = 2;
                    var obr = 1;
                    var oexp = 0;
                    var good = true;
                    var method = 2;
                    var a = 2;
                    while a < arg_count(g) && good {
                        if bytes.equal(arg(g, a), "--relax") {
                            relax = true;
                        } else if bytes.equal(arg(g, a), "--iteration-limit") && a + 1 < arg_count(g) && parse_count(arg(g, a + 1)) >= 0 {
                            limit = parse_count(arg(g, a + 1));
                            a = a + 1;
                        } else if bytes.equal(arg(g, a), "--method") && a + 1 < arg_count(g) && method_code(arg(g, a + 1)) >= 0 {
                            method = method_code(arg(g, a + 1));
                            a = a + 1;
                        } else if bytes.equal(arg(g, a), "--node-limit") && a + 1 < arg_count(g) && parse_count(arg(g, a + 1)) >= 0 {
                            onodes = parse_count(arg(g, a + 1));
                            a = a + 1;
                        } else if bytes.equal(arg(g, a), "--experiment") && a + 1 < arg_count(g) && parse_count(arg(g, a + 1)) >= 0 {
                            oexp = parse_count(arg(g, a + 1));
                            a = a + 1;
                        } else if bytes.equal(arg(g, a), "--node-select") && a + 1 < arg_count(g) && (bytes.equal(arg(g, a + 1), "depth") || bytes.equal(arg(g, a + 1), "best") || bytes.equal(arg(g, a + 1), "hybrid")) {
                            if bytes.equal(arg(g, a + 1), "depth") {
                                osel = 0;
                            } else if bytes.equal(arg(g, a + 1), "best") {
                                osel = 1;
                            } else {
                                osel = 2;
                            }
                            a = a + 1;
                        } else if bytes.equal(arg(g, a), "--branching") && a + 1 < arg_count(g) && (bytes.equal(arg(g, a + 1), "fractional") || bytes.equal(arg(g, a + 1), "pseudo")) {
                            if bytes.equal(arg(g, a + 1), "fractional") {
                                obr = 0;
                            }
                            a = a + 1;
                        } else {
                            good = false;
                        }
                        a = a + 1;
                    }
                    if good {
                        status = run_model(h, i, 2, relax, limit, method, onodes, osel, obr, oexp);
                    } else {
                        status = usage(h, i);
                    }
                } else if bytes.equal(arg(g, 1), "verify") {
                    var tol = 1.0e-6;
                    var good = true;
                    var a = 2;
                    while a < arg_count(g) && good {
                        if bytes.equal(arg(g, a), "--tolerance") && a + 1 < arg_count(g) && verify.parse_tolerance(h, arg(g, a + 1)) >= 0.0 {
                            tol = verify.parse_tolerance(h, arg(g, a + 1));
                            a = a + 1;
                        } else {
                            good = false;
                        }
                        a = a + 1;
                    }
                    if good {
                        status = run_verify(h, i, tol);
                    } else {
                        status = usage(h, i);
                    }
                } else if bytes.equal(arg(g, 1), "introspect") {
                    status = emit.introspect(h, i);
                } else if bytes.equal(arg(g, 1), "skill") {
                    status = emit.skill(i);
                } else {
                    status = usage(h, i);
                }
            }
        }
    }
    release(args);
    release(heap);
    release(io);
    return status;
}
